<?php
/**
 * Bold Payments PIGI iframe template.
 *
 * @var Bold_CheckoutPaymentBooster_Block_Payment_Form_Bold $this
 */
?>
<div id="payment_form_bold">
    <div id="smart-ppcp-buttons" class="bold-wallet-buttons"></div>
</div>

<script type="text/javascript">
    if (typeof window.bold === 'undefined') {
        window.bold = {};
    }

    /**
     * Bold order data sync class.
     */
    let BoldPaymentMethod = Class.create({
        paymentMethodElement: null,
        paymentCheckbox: null,
        isAvailable: <?php echo $this->isAvailable(); ?>,
        isFastlaneAvailable: <?php echo $this->isFastlaneAvailable(); ?>,
        paymentId: null,
        walletButtonsRendered: false,
        initialize: async function () {
            this.refreshDomReferences();
            if (!this.isAvailable) {
                this.hidePaymentMethod();
                return;
            }
            await this.waitForBaseInstance();
            await this.renderPaymentForm();
            this.subscribeToSpiEvents();
            this.waitForPaymentInitialization();
            this.waitForCheckoutInitialization();
            this.registerCheckoutObservers();
        },
        refreshDomReferences: function () {
            const checkbox = document.getElementById('p_method_bold');
            this.paymentCheckbox = checkbox;
            this.paymentMethodElement = checkbox ? checkbox.parentNode : null;
        },
        waitForBaseInstance: function () {
            return new Promise((resolve) => {
                const intervalId = setInterval(() => {
                    if (typeof window.bold.baseInstance !== 'undefined') {
                        clearInterval(intervalId);
                        resolve();
                    }
                }, 100);
                setTimeout(() => {
                    clearInterval(intervalId);
                    resolve();
                }, 10000);
            });
        },
        showPaymentForm: function () {
            const form = document.getElementById('payment_form_bold');
            if (form) {
                form.style.display = 'block';
            }
        },
        renderWalletButtons: async function (paymentInstance) {
            if (!paymentInstance || typeof paymentInstance.renderWalletPayments !== 'function') {
                return false;
            }
            const shopName = window.bold.baseInstance && window.bold.baseInstance.groupLabel
                ? window.bold.baseInstance.groupLabel
                : '';
            try {
                await paymentInstance.renderWalletPayments('smart-ppcp-buttons', {
                    allowedCountries: ['US', 'CA'],
                    fastlane: !!this.isFastlaneAvailable,
                    isPhoneRequired: true,
                    pageSource: 'checkout',
                    shopName: shopName,
                });
                this.walletButtonsRendered = true;
                this.showPaymentForm();
                this.showPaymentMethod();
                return true;
            } catch (e) {
                console.error('[Bold] Failed to render wallet buttons', e);
                return false;
            }
        },
        refreshWalletButtons: async function () {
            if (!this.isAvailable) {
                return;
            }
            this.refreshDomReferences();
            await this.waitForBaseInstance();
            if (window.bold.baseInstance && typeof window.bold.baseInstance.prefetchCartData === 'function') {
                try {
                    await window.bold.baseInstance.prefetchCartData();
                } catch (e) {
                    console.warn('[Bold] Could not refresh cart data for wallets', e);
                }
            }
            const host = document.getElementById('smart-ppcp-buttons');
            if (host) {
                host.innerHTML = '';
            }
            const paymentInstance = await window.bold.baseInstance.getBoldPaymentsInstance();
            await this.renderWalletButtons(paymentInstance);
        },
        renderPaymentForm: async function () {
            const boldPaymentsForm = document.getElementById('payment_form_bold');
            if (!boldPaymentsForm) {
                return;
            }
            if (window.bold.baseInstance && typeof window.bold.baseInstance.prefetchCartData === 'function') {
                try {
                    await window.bold.baseInstance.prefetchCartData();
                } catch (e) {
                    console.warn('[Bold] Could not prefetch cart data before payment render', e);
                }
            }
            const paymentInstance = await window.bold.baseInstance.getBoldPaymentsInstance();
            await this.renderWalletButtons(paymentInstance);

            if (this.isFastlaneAvailable) {
                return;
            }

            await paymentInstance.renderPayments(
                'payment_form_bold',
                {
                    fastlane: false,
                    shouldRenderSpiFrame: true,
                }
            );
            this.showPaymentForm();
        },
        onBoldPaymentSelected: function () {
            this.showPaymentMethod();
            this.showPaymentForm();
            if (!this.walletButtonsRendered) {
                this.refreshWalletButtons();
            }
        },
        registerCheckoutObservers: function () {
            if (window.bold.boldPaymentMethodObserversRegistered) {
                return;
            }
            window.bold.boldPaymentMethodObserversRegistered = true;
            document.observe('payment-method:switched', function (e) {
                if (e.memo && e.memo.method_code === 'bold' && window.bold.boldPaymentMethod) {
                    window.bold.boldPaymentMethod.onBoldPaymentSelected();
                }
            });
            document.observe('firecheckout:setResponseAfter', function (e) {
                const sections = e.memo && e.memo.response && e.memo.response.update_section;
                if (!sections || !window.bold.boldPaymentMethod) {
                    return;
                }
                const shouldRefresh = ['payment-method', 'cart', 'total', 'shipping-method', 'billing']
                    .some(function (section) {
                        return !!sections[section];
                    });
                if (shouldRefresh) {
                    window.bold.boldPaymentMethod.refreshWalletButtons();
                }
            });
            document.observe('firecheckout:paymentMethod:afterInitAfter', function () {
                window.bold.ensureBoldPaymentMethod();
            });
        },
        waitForCheckoutInitialization: function () {
            const intervalId = setInterval(() => {
                if (typeof checkout !== 'undefined' && checkout.save) {
                    this.wrapCheckoutSave();
                    clearInterval(intervalId);
                }
            }, 100);
            setTimeout(() => clearInterval(intervalId), 10000);
        },
        waitForPaymentInitialization: function () {
            const intervalId = setInterval(() => {
                if (typeof payment !== 'undefined' && payment.save) {
                    this.wrapPaymentSave();
                    clearInterval(intervalId);
                }
            }, 100);
            setTimeout(() => clearInterval(intervalId), 10000);
        },
        wrapCheckoutSave: function () {
            checkout.save = checkout.save.wrap(
                function (checkoutSaveMethod) {
                    if (!this.paymentCheckbox || !this.paymentCheckbox.checked) {
                        return checkoutSaveMethod();
                    }
                    checkout.validate();
                    if (!this.paymentId) {
                        checkout.setLoadWaiting('payment', true);
                        this.tokenize();
                        return;
                    }
                    checkout.setLoadWaiting(false);
                    checkoutSaveMethod();
                }.bind(this)
            );
        },
        wrapPaymentSave: function () {
            payment.save = payment.save.wrap(
                function (paymentSaveMethod) {
                    if (!this.paymentCheckbox || !this.paymentCheckbox.checked) {
                        return paymentSaveMethod();
                    }
                    if (!this.paymentId) {
                        checkout.setLoadWaiting('payment', true);
                        this.tokenize();
                        return;
                    }
                    checkout.setLoadWaiting(false);
                    paymentSaveMethod();
                }.bind(this)
            );
        },
        hidePaymentMethod: function () {
            if (this.paymentMethodElement) {
                this.paymentMethodElement.style.display = 'none';
            }
        },
        showPaymentMethod: function () {
            if (this.paymentMethodElement) {
                this.paymentMethodElement.style.display = 'block';
            }
        },
        tokenize: async function () {
            const iframe = document.getElementById('spi_frame_payment_form_bold');
            if (!iframe || !iframe.contentWindow) {
                console.error('[Bold] SPI iframe is not available');
                checkout.setLoadWaiting(false);
                return;
            }
            const cartData = await window.bold.baseInstance.getCartData();
            iframe.contentWindow.postMessage({
                actionType: 'ACTION_SPI_TOKENIZE',
                payload: {
                    customer: cartData.customer,
                    billing_address: cartData.billing_address,
                    shipping_address: cartData.shipping_address || cartData.billing_address,
                    totals: cartData.totals,
                }
            }, '*');
        },
        subscribeToSpiEvents() {
            window.addEventListener('message', ({data}) => {
                const eventType = data.eventType;
                if (!eventType) {
                    return;
                }
                switch (eventType) {
                    case 'EVENT_SPI_TOKENIZED':
                        if (!data.payload.success) {
                            this.paymentId = null;
                            checkout.setLoadWaiting(false);
                            return;
                        }
                        this.paymentId = data.payload?.payload?.data?.payment_id;
                        if (checkout.save) {
                            checkout.save();
                        } else {
                            payment.save();
                        }
                        break;
                    case 'EVENT_SPI_TOKENIZE_FAILED':
                        this.paymentId = null;
                        checkout.setLoadWaiting(false);
                        break;
                    case 'EVENT_SPI_PAYMENT_ORDER_SCA':
                    case 'EVENT_SPI_ENABLE_FULLSCREEN':
                        checkout.setLoadWaiting(false);
                        break;
                    case 'EVENT_SPI_DISABLE_FULLSCREEN':
                        checkout.setLoadWaiting('payment', true);
                        break;
                }
            });
        },
    });

    window.bold.ensureBoldPaymentMethod = function () {
        if (!window.bold.boldPaymentMethod) {
            window.bold.boldPaymentMethod = new BoldPaymentMethod();
        }
        return window.bold.boldPaymentMethod;
    };

    window.bold.ensureBoldPaymentMethod();
</script>
