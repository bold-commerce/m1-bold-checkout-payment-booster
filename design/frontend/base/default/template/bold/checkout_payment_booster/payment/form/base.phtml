        tokenize: async function () {
            if (!this.isCurrentRuntime() || !this.canAttemptTokenize()) {
                return;
            }
            this.dedupeSpiFrames();
            this.isTokenizing = true;
            try {
                const iframe = this.getActiveSpiFrame();
                if (!iframe || !iframe.contentWindow) {
                    console.error('[Bold] SPI iframe is not available');
                    this.isTokenizing = false;
                    checkout.setLoadWaiting(false);
                    return;
                }
                const cartData = await window.bold.baseInstance.getCartData();
                if (!this.isCurrentRuntime()) {
                    this.isTokenizing = false;
                    return;
                }
                iframe.contentWindow.postMessage({
                    actionType: 'ACTION_SPI_TOKENIZE',
                    payload: {
                        customer: cartData.customer,
                        billing_address: cartData.billing_address,
                        shipping_address: cartData.shipping_address || cartData.billing_address,
                        totals: cartData.totals,
                    }
                }, '*');
            } catch (e) {
                this.isTokenizing = false;
                checkout.setLoadWaiting(false);
                console.error('[Bold] tokenize failed', e);
            }
