<?php
/**
 * @var Bold_CheckoutPaymentBooster_Block_Payment_Form_Base $this
 */
?>

<script type="text/javascript">
    if (typeof window.bold === 'undefined') {
        window.bold = {};
    }

    window.bold.walletCheckoutConfig = <?php echo json_encode($this->getWalletCheckoutJsConfig()) ?>;

    /**
     * Bold Payments base class.
     */
    const BoldBase = Class.create({
        boldPaymentsInstance: null,
        authorizedEmail: null,
        fastlaneInstance: null,
        fastlaneProfileData: null,
        gatewayData: null,
        buildFastlaneInstanceInProgress: false,
        buildPaymentsInstanceInProgress: false,
        cachedCartData: null,
        getCartDataPromise: null,
        walletCheckoutCreateAllowed: false,
        walletCheckoutSessionActive: false,
        walletCreateOrderConsumed: false,
        walletPayCreateInFlight: false,
        walletPayCreatePromise: null,
        createExpressOrderInFlight: false,
        createExpressOrderPromise: null,
        isAvailable: <?php echo $this->isAvailable(); ?>,
        groupLabel: '<?php echo $this->getGroupLabel() ?>',
        boldApiUrl: '<?php echo $this->getBoldApiUrl(); ?>',
        jwtToken: '<?php echo $this->getJwtToken(); ?>',
        epsAuthToken: '<?php echo $this->getEpsAuthToken(); ?>',
        epsUrl: '<?php echo $this->getEpsUrl(); ?>',
        epsStaticUrl: '<?php echo $this->getEpsStaticUrl(); ?>',
        epsGatewayId: '<?php echo $this->getEpsGatewayId(); ?>',
        quoteCurrencyCode: '<?php echo $this->getQuoteCurrencyCode(); ?>',
        isFastlaneAvailable: <?php echo $this->isFastlaneAvailable(); ?>,
        billingAddressFieldsMap: {
            'firstname': 'billing:firstname',
            'lastname': 'billing:lastname',
            'company': 'billing:company',
            'telephone': 'billing:telephone',
            'street1': 'billing:street1',
            'street2': 'billing:street2',
            'city': 'billing:city',
            'region_id': 'billing:region_id',
            'country_id': 'billing:country_id',
            'postcode': 'billing:postcode',
            'use_for_shipping': 'billing:use_for_shipping_yes'
        },
        /**
         * Initialize class.
         *
         * @returns {*|boolean}
         */
        initialize: async function () {
            if (!this.isAvailable) {
                return false;
            }
            if (!this.isFastlaneAvailable) {
                return;
            }
            this.renderFastlaneWatermark();
            await this.authorizeFastlaneUser();
            this.subscribeToEmailChanges();
        },
        /**
         * Observe email changes to authorize Fastlane user.
         *
         * @return {void}
         */
        subscribeToEmailChanges: function () {
            const emailField = this.getEmailField();
            if (!emailField) {
                return;
            }
            emailField.observe('change', () => {
                setTimeout(async () => {
                    await this.authorizeFastlaneUser();
                }, 500);
            });
        },
        /**
         * Remove Fastlane watermark placeholder in case fastlane is not available.
         *
         * @return {void}
         */
        removeWatermarkPlaceholder: function () {
            const watermarkContainer = document.getElementById('fastlane-watermark-container');
            if (watermarkContainer) {
                watermarkContainer.remove();
            }
        },
        /**
         * Render Fastlane watermark.
         *
         * @return {void}
         */
        renderFastlaneWatermark: async function () {
            this.renderFastlaneWatermarkPlaceholder();
            const fastlaneInstance = await this.getFastlaneInstance();
            const watermarkComponent = await fastlaneInstance.FastlaneWatermarkComponent({includeAdditionalInfo: true});
            let watermarkContainer = document.getElementById('fastlane-email-watermark-container');
            if (watermarkContainer) {
                watermarkContainer.style = 'float: right';
                watermarkComponent.render('#fastlane-email-watermark-container');
            }
        },
        /**
         * Render Fastlane watermark placeholder to show watermark immediately before fastlane is initialize.
         *
         * @return {void}
         */
        renderFastlaneWatermarkPlaceholder: function () {
            const emailField = this.getEmailField();
            if (!emailField) {
                return;
            }
            const watermarkContainerId = 'fastlane-watermark-container';
            const existingWatermarkContainer = document.getElementById(watermarkContainerId);
            if (existingWatermarkContainer) {
                return;
            }
            const watermarkContainer = document.createElement('div');
            const watermarkSubContainer = document.createElement('div');
            const watermark = document.createElement('img');
            watermarkSubContainer.id = 'fastlane-email-watermark-container';
            watermarkSubContainer.style = 'float: right; margin-top: 5px';
            watermark.src = 'https://www.paypalobjects.com/connect-boba/assets/FastLaneLogoSmall.svg';
            watermark.alt = '';
            watermarkSubContainer.appendChild(watermark);
            watermarkContainer.id = watermarkContainerId;
            watermarkContainer.style = '<?php echo $this->getWatermarkContainerStyle(); ?>';
            watermarkContainer.appendChild(watermarkSubContainer);
            emailField.insertAdjacentElement('afterend', watermarkContainer);
        },
        /**
         * Build Fastlane Instance considering gateway type.
         *
         * @return {Promise<{}>}
         */
        getFastlaneInstance: async function () {
            if (this.fastlaneInstance) {
                this.buildFastlaneInstanceInProgress = false;
                return this.fastlaneInstance;
            }
            if (this.buildFastlaneInstanceInProgress) {
                return new Promise((resolve) => {
                    setTimeout(() => {
                        resolve(this.getFastlaneInstance());
                    }, 500);
                });
            }
            this.buildFastlaneInstanceInProgress = true;
            const boldPaymentsInstance = await this.getBoldPaymentsInstance();
            const fastlaneClient = await boldPaymentsInstance.getFastlaneClientInit({
                shouldLoadScript: true
            });
            this.gatewayData = fastlaneClient[this.epsGatewayId] || null;
            if (!this.gatewayData) {
                return null;
            }
            if (this.gatewayData.is_test_mode) {
                window.localStorage.setItem('axoEnv', 'sandbox');
                window.localStorage.setItem('fastlaneEnv', 'sandbox');
            }
            if (this.gatewayData.type === 'braintree') {
                this.fastlaneInstance = await this.buildBraintreeFastlaneInstance();
            }
            if (this.gatewayData.type === 'ppcp') {
                this.fastlaneInstance = await this.buildPpcpFastlaneInstance();
            }
            this.buildFastlaneInstanceInProgress = false;
            return this.fastlaneInstance;
        },
        /**
         * Build Fastlane Instance for the Braintree.
         *
         * @return {Promise<void>}
         */
        buildBraintreeFastlaneInstance: async function () {
            await this.loadScript(
                'https://js.braintreegateway.com/web/3.106.0/js/client.min.js'
            );
            await this.loadScript(
                'https://js.braintreegateway.com/web/3.106.0/js/data-collector.min.js'
            );
            await this.loadScript(
                'https://js.braintreegateway.com/web/3.106.0/js/hosted-fields.min.js'
            );
            await this.loadScript(
                'https://js.braintreegateway.com/web/3.106.0/js/fastlane.min.js'
            );
            const clientInstance = await window.braintree.client.create({
                authorization: this.gatewayData.client_token,
            });
            const dataCollectorInstance = await window.braintree.dataCollector.create(
                {
                    client: clientInstance,
                }
            );
            const {deviceData} = dataCollectorInstance;
            return window.braintree.fastlane.create({
                authorization: this.gatewayData.client_token,
                client: clientInstance,
                deviceData: deviceData,
            });
        },
        /**
         * Build Fastlane Instance for the PPCP.
         *
         * @return {Promise<{}>}
         * @private
         */
        buildPpcpFastlaneInstance: async function () {
            return window.paypal.Fastlane();
        },
        /**
         * Authorize user with email.
         *
         * @return {Promise<void>}
         */
        authorizeFastlaneUser: async function () {
            const emailField = this.getEmailField();
            if (!emailField || !emailField.value || this.authorizedEmail === emailField.value) {
                return;
            }
            if (!window.Validation.validate(emailField)) {
                return;
            }
            checkout.setLoadWaiting('billing', true);
            this.authorizedEmail = emailField.value;
            try {
                const {identity} = await this.getFastlaneInstance();
                const {customerContextId} = await identity.lookupCustomerByEmail(emailField.value);
                checkout.setLoadWaiting(false);
                if (!customerContextId) {
                    this.removeAddressButton();
                    this.fastlaneProfileData = null;
                    if (window.bold.fastlanePaymentMethod) {
                        window.bold.fastlanePaymentMethod.renderFastlanePaymentComponent();
                    }
                    return;
                }
                const {
                    authenticationState,
                    profileData
                } = await identity.triggerAuthenticationFlow(customerContextId);
                if (authenticationState === 'succeeded') {
                    checkout.setLoadWaiting('billing', true);
                    this.fastlaneProfileData = profileData;
                    if (profileData.shippingAddress) {
                        this.updateBillingAddressFormValues(profileData.shippingAddress);
                        this.addAddressButton();
                    }
                    if (window.bold.fastlanePaymentMethod) {
                        window.bold.fastlanePaymentMethod.selectPaymentMethod();
                        window.bold.fastlanePaymentMethod.renderFastlanePaymentComponent();
                    }
                    checkout.setLoadWaiting(false);
                }
            } catch (error) {
                console.error('Error:', error);
            }
        },
        /**
         * Fill billing address form with Fastlane address.
         *
         * @param {{}} fastlaneAddress
         * @return {void}
         */
        updateBillingAddressFormValues: function (fastlaneAddress) {
            const magentoAddress = this.convertFastlaneAddressToMagentoAddress(fastlaneAddress);
            Object.keys(this.billingAddressFieldsMap).forEach((field) => {
                if (magentoAddress[field] && document.getElementById(this.billingAddressFieldsMap[field])) {
                    const element = document.getElementById(this.billingAddressFieldsMap[field]);
                    if (!element) {
                        return;
                    }
                    element.value = magentoAddress[field];
                }
            });
        },
        /**
         * Convert Fastlane address to Magento address.
         *
         * @param fastlaneAddress {{}}
         * @return {{}}
         */
        convertFastlaneAddressToMagentoAddress: function (fastlaneAddress) {
            let magentoAddressRegionId = null;
            const fastlaneCountryCode = fastlaneAddress.countryCodeAlpha2 || fastlaneAddress.address?.countryCode;
            const fastlaneRegionCode = fastlaneAddress.region || fastlaneAddress.address?.adminArea1;
            if (window.billingRegionUpdater.regions[fastlaneCountryCode]) {
                Object.entries(window.billingRegionUpdater.regions[fastlaneCountryCode]).each((region) => {
                    const [regionId, regionData] = region;
                    if (regionData.code === fastlaneRegionCode) {
                        magentoAddressRegionId = regionId;
                    }
                })
            }
            const telephone = typeof fastlaneAddress.phoneNumber === 'string'
                ? fastlaneAddress.phoneNumber
                : fastlaneAddress.phoneNumber?.countryCode + fastlaneAddress.phoneNumber?.nationalNumber;
            return {
                'firstname': fastlaneAddress.firstName || fastlaneAddress.name?.firstName,
                'lastname': fastlaneAddress.lastName || fastlaneAddress.name?.lastName,
                'company': fastlaneAddress.company,
                'telephone': telephone,
                'street1': fastlaneAddress.streetAddress || fastlaneAddress.address?.addressLine1,
                'street2': fastlaneAddress.extendedAddress || fastlaneAddress.address?.addressLine2,
                'city': fastlaneAddress.locality || fastlaneAddress.address?.adminArea2,
                'region_id': magentoAddressRegionId,
                'postcode': fastlaneAddress.postalCode || fastlaneAddress.address?.postalCode,
                'country_id': fastlaneCountryCode,
            };
        },
        /**
         * Remove change address button from billing address form.
         *
         * @return {void}
         */
        removeAddressButton: function () {
            const fastlaneAddressContainer = document.getElementById('fastlane-address-container');
            if (fastlaneAddressContainer) {
                fastlaneAddressContainer.remove();
            }
        },
        /**
         * Add change address button on billing address form.
         *
         * @return {{}}
         */
        addAddressButton: function () {
            this.removeAddressButton();
            const fastlaneAddressContainer = document.createElement('fieldset');
            fastlaneAddressContainer.id = 'fastlane-address-container';
            fastlaneAddressContainer.style = '<?php echo $this->getAddressContainerStyle(); ?>';
            const updateAddressButton = document.createElement('button');
            updateAddressButton.type = 'button';
            updateAddressButton.className = 'button';
            updateAddressButton.innerHTML = 'Change Address';
            updateAddressButton.addEventListener('click', () => {
                this.getFastlaneInstance().then((fastlaneInstance) => {
                    if (!fastlaneInstance) {
                        return;
                    }
                    fastlaneInstance.profile.showShippingAddressSelector().then((editAddressResult) => {
                        if (!editAddressResult.selectionChanged) {
                            return;
                        }
                        this.updateBillingAddressFormValues(editAddressResult.selectedAddress);
                    });
                });
            });
            fastlaneAddressContainer.appendChild(updateAddressButton);
            const billingAddressForm = document.getElementById('billing-new-address-form');
            if (billingAddressForm) {
                billingAddressForm.appendChild(fastlaneAddressContainer);
            }
        },
        /**
         * Load SPI SDK.
         *
         * @returns {Promise<void>}
         */
        getBoldPaymentsInstance: async function () {
            if (this.boldPaymentsInstance) {
                this.buildPaymentsInstanceInProgress = false;
                return this.boldPaymentsInstance;
            }
            if (this.buildPaymentsInstanceInProgress) {
                return new Promise((resolve) => {
                    setTimeout(() => {
                        resolve(this.getBoldPaymentsInstance());
                    }, 500);
                });
            }
            this.buildPaymentsInstanceInProgress = true;
            await this.loadScript(this.epsStaticUrl + '/js/payments_sdk.js');
            const initialData = {
                'eps_url': this.epsUrl,
                'eps_bucket_url': this.epsStaticUrl,
                'group_label': this.groupLabel,
                'trace_id': '<?php echo $this->getPublicOrderID(); ?>',
                'payment_gateways': [
                    {
                        'gateway_id': Number(this.epsGatewayId),
                        'auth_token': this.epsAuthToken,
                        'currency': this.quoteCurrencyCode,
                    }
                ],
                'callbacks': {
                    'onClickPaymentOrder': async function (paymentType, paymentPayload) {
                        if (!this.isWalletCheckoutPayment(paymentPayload)
                            && paymentType !== 'apple'
                            && paymentType !== 'google') {
                            return;
                        }
                        if (!this.walletCheckoutCreateAllowed) {
                            return;
                        }
                        try {
                            await this.prefetchCartData();
                        } catch (e) {
                            console.warn('[Bold] Wallet cart prefetch on click failed', e);
                        }
                    }.bind(this),
                    'onCreatePaymentOrder': async function (paymentType, paymentPayload) {
                        try {
                            if (this.isWalletCheckoutPayment(paymentPayload)
                                || paymentType === 'apple'
                                || paymentType === 'google') {
                                if (this.shouldDeferWalletButtonCreate()) {
                                    return undefined;
                                }
                                window.bold.walletPayOrderLock = true;
                                this.walletCreateOrderConsumed = true;
                                this.walletCheckoutCreateAllowed = false;
                                this.walletCheckoutSessionActive = true;
                                return await this.handleWalletCreatePaymentOrder(paymentPayload);
                            }
                            if (paymentType !== 'ppcp') {
                                return;
                            }
                            if (!this.shouldAllowPpcpCreatePaymentOrder()) {
                                return undefined;
                            }
                            const createOrderResult = await this.createExpressOrder(paymentPayload);
                            return {payment_data: {id: createOrderResult.order_id, order_id: createOrderResult.order_id}};
                        } catch (e) {
                            console.error('Failed to create payment order', e);
                            throw e;
                        }
                    }.bind(this),
                    'onUpdatePaymentOrder': async function (paymentType, paymentPayload) {
                        if (this.isWalletCheckoutPayment(paymentPayload)) {
                            if (!this.walletCheckoutSessionActive) {
                                return;
                            }
                            return await this.handleWalletUpdatePaymentOrder(paymentPayload);
                        }
                    }.bind(this),
                    'onApprovePaymentOrder': async function (paymentType, paymentInformation, paymentPayload) {
                        try {
                            if (paymentType === 'google' || paymentType === 'apple'
                                || this.isWalletCheckoutPayment(paymentPayload)) {
                                await this.handleWalletApprovePaymentOrder(paymentPayload, paymentInformation);
                                return;
                            }
                            if (paymentType !== 'ppcp') {
                                return;
                            }
                            if (!paymentInformation.payment_id) {
                                console.error('No payment ID provided from PayPal.');
                                return;
                            }
                            if (window.bold.boldPaymentMethod) {
                                window.bold.boldPaymentMethod.paymentId = paymentInformation.payment_id;
                            }
                            if (typeof payment !== 'undefined' && payment.save) {
                                payment.save();
                            }
                        } catch (e) {
                            console.error('Failed to approve payment order', e);
                            throw e;
                        }
                    }.bind(this),
                    'onScaPaymentOrder': async function (type, payload) {
                        if (type !== 'ppcp') {
                            throw new Error('Unsupported payment type');
                        }
                        const url = `${this.boldApiUrl}payments/on_sca`;
                        const orderId = payload.order_id;
                        const scaResult = await fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${this.jwtToken}`
                            },
                            body: JSON.stringify(
                                {
                                    'order_id': orderId,
                                    'public_order_id': '<?php echo $this->getPublicOrderID(); ?>',
                                    'gateway_type': 'ppcp',
                                }
                            ),
                        });
                        if (!scaResult.ok) {
                            throw new Error('SCA failed');
                        }
                        const data = await scaResult.json();
                        return {card: data};
                    }.bind(this),
                    'onRequireOrderData': function (requirements) {
                        try {
                            return this.onRequireOrderDataCallback(requirements);
                        } catch (e) {
                            if (typeof checkout !== 'undefined') {
                                checkout.setLoadWaiting('billing', false);
                            }
                            throw e;
                        }
                    }.bind(this),
                }
            };
            this.boldPaymentsInstance = new window.bold.Payments(initialData);
            this.buildPaymentsInstanceInProgress = false;
            return this.boldPaymentsInstance;
        },
        /**
         * Reset cached Payments SDK so SPI can render again after DOM teardown.
         *
         * @return {void}
         */
        resetPaymentsInstance: function () {
            this.clearWalletCheckoutSession();
            this.createExpressOrderInFlight = false;
            this.createExpressOrderPromise = null;
            this.walletPayCreateInFlight = false;
            this.walletPayCreatePromise = null;
            this.boldPaymentsInstance = null;
            this.buildPaymentsInstanceInProgress = false;
        },
        armWalletCheckoutCreate: function () {
            this.walletCheckoutCreateAllowed = true;
            this.walletCreateOrderConsumed = false;
            window.bold.walletPayOrderLock = false;
        },
        shouldDeferWalletButtonCreate: function () {
            return !!(window.bold.checkoutSdkMounting
                || window.bold.walletSdkMounting
                || window.bold.walletPayOrderLock
                || !this.walletCheckoutCreateAllowed
                || this.walletCreateOrderConsumed);
        },
        shouldAllowPpcpCreatePaymentOrder: function () {
            if (window.bold.checkoutSdkMounting || window.bold.walletSdkMounting) {
                return false;
            }
            const method = window.bold.boldPaymentMethod;
            if (method && method.isTokenizing) {
                return true;
            }
            if (this.walletCheckoutCreateAllowed && !this.walletCreateOrderConsumed) {
                return true;
            }
            return false;
        },
        clearWalletCheckoutSession: function () {
            this.walletCheckoutCreateAllowed = false;
            this.walletCheckoutSessionActive = false;
            this.walletCreateOrderConsumed = false;
            window.bold.walletPayOrderLock = false;
        },
        /**
         * Load specified script with attributes.
         *
         * @param {string} src
         * @param {Object} attributes
         * @returns {Promise<void>}
         * @private
         */
        loadScript: async function (src, attributes = {}) {
            return new Promise((resolve, reject) => {
                const script = document.createElement('script');
                script.src = src;
                script.async = true;
                script.onload = resolve;
                script.onerror = reject;
                if (attributes.constructor === Object) {
                    Object.keys(attributes).forEach((key) => {
                        script.setAttribute(key, attributes[key]);
                    });
                }
                document.head.appendChild(script);
            });
        },
        /**
         * Get email field.
         *
         * @return {HTMLElement}
         * @private
         */
        getEmailField: function () {
            return document.getElementById('billing:email');
        },
        cacheCartData: function (cartData) {
            this.cachedCartData = cartData;
            return cartData;
        },
        getCachedCartData: function () {
            return this.cachedCartData;
        },
        prefetchCartData: function () {
            return this.getCartData();
        },
        getCartData: function () {
            if (this.getCartDataPromise) {
                return this.getCartDataPromise;
            }
            this.getCartDataPromise = new Promise((resolve, reject) => {
                new Ajax.Request('/checkoutpaymentbooster/index/getCartData', {
                    method: 'get',
                    parameters: {form_key: '<?php echo Mage::getSingleton('core/session')->getFormKey() ?>'},
                    onSuccess: (response) => {
                        try {
                            resolve(this.cacheCartData(JSON.parse(response.responseText)));
                        } catch (e) {
                            reject(e);
                        }
                    },
                    onFailure: () => {
                        reject(new Error('Failed to get cart data'));
                    },
                    onComplete: () => {
                        this.getCartDataPromise = null;
                    }
                });
            });
            return this.getCartDataPromise;
        },
        resolveBillingAddressForCustomerRequirement: function (cartData) {
            if (typeof cartData.billingAddress === 'function') {
                return cartData.billingAddress();
            }
            return cartData.billing_address || {};
        },
        normalizeWalletAmountCents: function (value) {
            const amount = Number(value);
            if (!isFinite(amount) || isNaN(amount)) {
                return 0;
            }
            return Math.round(amount);
        },
        parsePriceTextToCents: function (text) {
            if (!text) {
                return 0;
            }
            const cleaned = String(text).replace(/[^\d.-]/g, '');
            const dollars = parseFloat(cleaned);
            if (!isFinite(dollars) || isNaN(dollars)) {
                return 0;
            }
            return Math.round(dollars * 100);
        },
        readCheckoutGrandTotalCents: function () {
            const selectors = [
                '#checkout-review-table .grand-total .price',
                '.checkout-review-table .grand-total .price',
                '#review-total-table .grand-total .price',
                '.firecheckout-summary .grand-total .price',
                '.grand-total .price'
            ];
            for (let i = 0; i < selectors.length; i++) {
                const el = document.querySelector(selectors[i]);
                if (el) {
                    const cents = this.parsePriceTextToCents(el.innerText || el.textContent);
                    if (cents > 0) {
                        return cents;
                    }
                }
            }
            return 0;
        },
        buildWalletTotalsFromCartData: function (totals) {
            const orderBalanceCents = this.normalizeWalletAmountCents(totals.order_total);
            return {
                order_total: orderBalanceCents / 100,
                order_balance: orderBalanceCents,
                shipping_total: this.normalizeWalletAmountCents(totals.shipping_total),
                discounts_total: this.normalizeWalletAmountCents(totals.discount_total),
                fees_total: this.normalizeWalletAmountCents(totals.fee_total),
                taxes_total: this.normalizeWalletAmountCents(totals.tax_total),
            };
        },
        normalizeWalletShippingOptions: function (shippingOptions) {
            return (shippingOptions || []).map(function (option) {
                return {
                    id: option.id || option.rate_id || '',
                    label: option.label || '',
                    amount: this.normalizeWalletAmountCents(option.amount),
                    is_selected: !!option.is_selected,
                };
            }.bind(this));
        },
        buildOrderDataFromCartData: function (requirements, cartData) {
            const orderData = {};
            for (const requirement of requirements) {
                switch (requirement) {
                    case 'customer': {
                        const billingAddress = this.resolveBillingAddressForCustomerRequirement(cartData);
                        const customer = cartData.customer || {};
                        const email = customer.email || customer.email_address || '';
                        orderData[requirement] = {
                            first_name: billingAddress.first_name || billingAddress.firstname || '',
                            last_name: billingAddress.last_name || billingAddress.lastname || '',
                            email_address: email,
                        };
                        break;
                    }
                    case 'items':
                        orderData[requirement] = (cartData.cart_items || []).map(function (item) {
                            return {
                                amount: this.normalizeWalletAmountCents(item.price),
                                label: item.title || item.name || '',
                            };
                        }.bind(this));
                        break;
                    case 'billing_address':
                        orderData[requirement] = cartData.billing_address;
                        break;
                    case 'shipping_address':
                        orderData[requirement] = cartData.shipping_address;
                        break;
                    case 'shipping_options':
                        orderData[requirement] = this.normalizeWalletShippingOptions(cartData.shipping_options);
                        break;
                    case 'totals':
                        orderData[requirement] = this.buildWalletTotalsFromCartData(cartData.totals || {});
                        break;
                }
            }
            return orderData;
        },
        isWalletCheckoutPayment: function (paymentPayload) {
            const walletType = paymentPayload
                && paymentPayload.payment_data
                && paymentPayload.payment_data.payment_type;
            return walletType === 'apple' || walletType === 'google';
        },
        cloneWalletPayload: function (paymentPayload) {
            try {
                return JSON.parse(JSON.stringify(paymentPayload));
            } catch (e) {
                return paymentPayload;
            }
        },
        cacheWalletOrderId: function (orderId) {
            if (orderId) {
                window.bold.lastWalletEpsOrderId = String(orderId);
            }
        },
        resolveWalletOrderId: function (paymentPayload, paymentInformation) {
            const data = paymentPayload && paymentPayload.payment_data ? paymentPayload.payment_data : {};
            if (data.order_id) {
                return String(data.order_id);
            }
            if (data.id) {
                return String(data.id);
            }
            if (paymentInformation) {
                if (paymentInformation.order_id) {
                    return String(paymentInformation.order_id);
                }
                if (paymentInformation.payment_id) {
                    return String(paymentInformation.payment_id);
                }
            }
            if (window.bold.lastWalletEpsOrderId) {
                return window.bold.lastWalletEpsOrderId;
            }
            return null;
        },
        normalizeWalletAddressFields: function (addressData) {
            if (!addressData) {
                return null;
            }
            const street = [];
            if (addressData.addressLines && addressData.addressLines.length) {
                street.push(addressData.addressLines[0]);
                if (addressData.addressLines[1]) {
                    street.push(addressData.addressLines[1]);
                }
            } else {
                street.push(
                    addressData.address_line_1 || addressData.address_line1 || addressData.address1 || ''
                );
                const line2 = addressData.address_line_2 || addressData.address_line2 || addressData.address2;
                if (line2) {
                    street.push(line2);
                }
            }
            return {
                email: addressData.email || addressData.emailAddress || '',
                firstname: addressData.first_name || addressData.givenName || 'Unknown',
                lastname: addressData.last_name || addressData.familyName || 'Person',
                street: street,
                city: addressData.city || addressData.locality || '',
                postcode: addressData.postal_code || addressData.postalCode || '',
                country_id: addressData.country_code || addressData.countryCode || 'US',
                telephone: addressData.phone || addressData.phoneNumber || '5555551234',
                region: addressData.state || addressData.administrativeArea || '',
            };
        },
        postWalletForm: function (url, parameters) {
            return new Promise(function (resolve, reject) {
                new Ajax.Request(url, {
                    method: 'post',
                    parameters: parameters,
                    onSuccess: function (transport) {
                        try {
                            resolve(transport.responseText.evalJSON());
                        } catch (e) {
                            resolve({});
                        }
                    },
                    onFailure: function () {
                        reject(new Error('Request failed: ' + url));
                    }
                });
            });
        },
        getCheckoutPlaceOrderForm: function () {
            const selectors = [
                '#firecheckout-form',
                'form#checkout-form',
                'form[name="firecheckout"]',
                'form[action*="firecheckout"]',
            ];
            let i;
            for (i = 0; i < selectors.length; i++) {
                const match = document.querySelector(selectors[i]);
                if (match && match.tagName === 'FORM') {
                    return match;
                }
            }
            const paymentSection = document.getElementById('co-payment-form');
            if (paymentSection) {
                if (paymentSection.tagName === 'FORM') {
                    return paymentSection;
                }
                if (paymentSection.closest) {
                    const parentForm = paymentSection.closest('form');
                    if (parentForm) {
                        return parentForm;
                    }
                }
            }
            const boldPaymentForm = document.getElementById('payment_form_bold');
            if (boldPaymentForm && boldPaymentForm.closest) {
                return boldPaymentForm.closest('form');
            }
            return null;
        },
        handleWalletSaveOrderResult: function (result) {
            const cfg = window.bold.walletCheckoutConfig;
            if (!result) {
                return;
            }
            if (result.error_messages) {
                const message = Array.isArray(result.error_messages)
                    ? result.error_messages.join('\n')
                    : result.error_messages;
                throw new Error(message);
            }
            if (result.error && result.message) {
                throw new Error(result.message);
            }
            if (result.redirect) {
                window.location.href = result.redirect;
                return;
            }
            if (result.success) {
                window.location.href = cfg.successUrl;
                return;
            }
            if (result.goto_section && typeof checkout !== 'undefined' && checkout.gotoSection) {
                checkout.gotoSection(result.goto_section, result.redirect);
                throw new Error(
                    result.message || 'Please complete all required checkout fields before placing your order.'
                );
            }
        },
        postWalletSaveOrder: async function (orderId) {
            const cfg = window.bold.walletCheckoutConfig;
            const form = this.getCheckoutPlaceOrderForm();
            let parameters = 'form_key=' + encodeURIComponent(cfg.formKey);
            if (form && typeof Form !== 'undefined' && Form.serialize) {
                parameters = Form.serialize(form);
                if (!/[&?]form_key=/.test(parameters)) {
                    parameters += '&form_key=' + encodeURIComponent(cfg.formKey);
                }
            }
            parameters += '&payment[method]=bold';
            parameters += '&payment[additional_data][order_id]=' + encodeURIComponent(orderId);
            const result = await new Promise(function (resolve, reject) {
                new Ajax.Request(cfg.saveOrderUrl, {
                    method: 'post',
                    postBody: parameters,
                    contentType: 'application/x-www-form-urlencoded',
                    onSuccess: function (transport) {
                        try {
                            resolve(transport.responseText.evalJSON());
                        } catch (e) {
                            resolve({});
                        }
                    },
                    onFailure: function () {
                        reject(new Error('Request failed: ' + cfg.saveOrderUrl));
                    }
                });
            });
            this.handleWalletSaveOrderResult(result);
        },
        applyWalletAddressToQuote: async function (addressType, addressData) {
            const normalized = this.normalizeWalletAddressFields(addressData);
            if (!normalized) {
                return;
            }
            const cfg = window.bold.walletCheckoutConfig;
            const params = {
                form_key: cfg.formKey,
                source: 'bold_wallet_checkout'
            };
            const prefix = addressType + '[';
            params[prefix + 'firstname]'] = normalized.firstname;
            params[prefix + 'lastname]'] = normalized.lastname;
            params[prefix + 'street][]'] = normalized.street[0] || '';
            if (normalized.street[1]) {
                params[prefix + 'street][]'] = normalized.street[1];
            }
            params[prefix + 'city]'] = normalized.city;
            params[prefix + 'postcode]'] = normalized.postcode;
            params[prefix + 'country_id]'] = normalized.country_id;
            params[prefix + 'telephone]'] = normalized.telephone;
            params[prefix + 'region]'] = normalized.region;
            if (normalized.email) {
                params[prefix + 'email]'] = normalized.email;
            }
            const url = addressType === 'shipping' ? cfg.saveShippingUrl : cfg.saveBillingUrl;
            await this.postWalletForm(url, params);
        },
        applyWalletAddressesFromPayload: async function (paymentPayload) {
            const data = paymentPayload.payment_data || {};
            if (!window.bold.walletCheckoutConfig.quoteIsVirtual && data.shipping_address) {
                await this.applyWalletAddressToQuote('shipping', data.shipping_address);
            }
            if (data.billing_address) {
                await this.applyWalletAddressToQuote('billing', data.billing_address);
            }
        },
        applyWalletShippingFromPayload: async function (paymentPayload) {
            const cfg = window.bold.walletCheckoutConfig;
            if (cfg.quoteIsVirtual) {
                return;
            }
            const shippingOptions = paymentPayload.payment_data && paymentPayload.payment_data.shipping_options;
            if (!shippingOptions) {
                return;
            }
            const optionId = shippingOptions.id || shippingOptions.identifier;
            if (!optionId || optionId === 'shipping_option_unselected') {
                return;
            }
            await this.postWalletForm(cfg.saveShippingMethodUrl, {
                form_key: cfg.formKey,
                shipping_method: optionId
            });
        },
        handleWalletCreatePaymentOrder: async function (paymentPayload) {
            if (this.walletPayCreateInFlight && this.walletPayCreatePromise) {
                return this.walletPayCreatePromise;
            }
            this.walletPayCreateInFlight = true;
            this.walletPayCreatePromise = (async () => {
                try {
                    const payload = this.cloneWalletPayload(paymentPayload);
                    await this.applyWalletAddressesFromPayload(payload);
                    const createOrderResult = await this.createExpressOrder(payload);
                    const orderId = createOrderResult.order_id;
                    this.cacheWalletOrderId(orderId);
                    return {payment_data: {id: orderId, order_id: orderId}};
                } catch (e) {
                    window.bold.walletPayOrderLock = false;
                    this.walletCreateOrderConsumed = false;
                    throw e;
                } finally {
                    this.walletPayCreateInFlight = false;
                    this.walletPayCreatePromise = null;
                }
            })();
            return this.walletPayCreatePromise;
        },
        handleWalletUpdatePaymentOrder: async function (paymentPayload) {
            const payload = this.cloneWalletPayload(paymentPayload);
            if (payload.payment_data) {
                this.cacheWalletOrderId(payload.payment_data.order_id || payload.payment_data.id);
            }
            if (!window.bold.walletCheckoutConfig.quoteIsVirtual) {
                if (payload.payment_data && payload.payment_data.shipping_address) {
                    await this.applyWalletAddressToQuote('shipping', payload.payment_data.shipping_address);
                }
                await this.applyWalletShippingFromPayload(payload);
            }
            if (payload.payment_data && payload.payment_data.billing_address) {
                await this.applyWalletAddressToQuote('billing', payload.payment_data.billing_address);
            }
            await this.prefetchCartData();
            if (payload.require_order_data) {
                return this.onRequireOrderDataCallback(payload.require_order_data);
            }
        },
        handleWalletApprovePaymentOrder: async function (paymentPayload, paymentInformation) {
            try {
                const orderId = this.resolveWalletOrderId(paymentPayload, paymentInformation);
                if (!orderId) {
                    throw new Error('Wallet order id is missing');
                }
                this.cacheWalletOrderId(orderId);
                await this.applyWalletAddressesFromPayload(paymentPayload);
                await this.applyWalletShippingFromPayload(paymentPayload);
                const method = window.bold.boldPaymentMethod;
                if (!method) {
                    throw new Error('Bold payment method is not initialized');
                }
                method.paymentId = orderId;
                await method.placeWalletOrder();
            } finally {
                this.clearWalletCheckoutSession();
            }
        },
        createExpressOrder: function (paymentPayload) {
            if (this.createExpressOrderInFlight && this.createExpressOrderPromise) {
                return this.createExpressOrderPromise;
            }
            this.createExpressOrderInFlight = true;
            const cfg = window.bold.walletCheckoutConfig;
            const gatewayId = paymentPayload && paymentPayload.gateway_id;
            this.createExpressOrderPromise = new Promise((resolve, reject) => {
                new Ajax.Request(cfg.createOrderUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    parameters: {
                        form_key: cfg.formKey,
                        quote_id: cfg.quoteId,
                        gateway_id: gatewayId,
                        shipping_strategy: (paymentPayload && paymentPayload.shipping_strategy) || 'dynamic'
                    },
                    onSuccess: (response) => {
                        try {
                            resolve(JSON.parse(response.responseText));
                        } catch (e) {
                            reject(e);
                        }
                    },
                    onFailure: () => {
                        reject(new Error('Failed to create express order'));
                    },
                    onComplete: () => {
                        this.createExpressOrderInFlight = false;
                        this.createExpressOrderPromise = null;
                    }
                });
            });
            return this.createExpressOrderPromise;
        },
        onRequireOrderDataCallback: function (requirements) {
            let cartData = this.getCachedCartData();
            if (!cartData) {
                this.prefetchCartData();
                cartData = this.buildMinimalCartDataFallback();
            }
            if (!cartData.cart_items || !cartData.cart_items.length) {
                const totals = cartData.totals || {};
                const amount = this.normalizeWalletAmountCents(totals.order_total) || this.readCheckoutGrandTotalCents();
                cartData.cart_items = [{price: amount, title: 'Order'}];
            }
            try {
                return this.buildOrderDataFromCartData(requirements, cartData);
            } catch (e) {
                console.error('[Bold] onRequireOrderData failed', e);
                return this.buildOrderDataFromCartData(requirements, this.buildMinimalCartDataFallback());
            }
        },
        buildMinimalCartDataFallback: function () {
            const emailEl = document.getElementById('billing:email');
            const firstEl = document.getElementById('billing:firstname');
            const lastEl = document.getElementById('billing:lastname');
            const orderTotalCents = this.readCheckoutGrandTotalCents();
            return {
                customer: {
                    email_address: emailEl ? emailEl.value : '',
                    first_name: firstEl ? firstEl.value : '',
                    last_name: lastEl ? lastEl.value : '',
                },
                billing_address: {},
                cart_items: [],
                totals: {
                    order_total: orderTotalCents,
                    shipping_total: 0,
                    discount_total: 0,
                    tax_total: 0,
                    fee_total: 0,
                },
                shipping_options: [],
            };
        },

    });

    /**
     * Bold payment method — single instance in base.phtml (Firecheckout AJAX reloads bold_method markup only).
     */
    const BoldPaymentMethod = Class.create({
        paymentMethodElement: null,
        paymentCheckbox: null,
        isAvailable: <?php echo $this->isAvailable(); ?>,
        isFastlaneAvailable: <?php echo $this->isFastlaneAvailable(); ?>,
        paymentId: null,
        paymentRuntimeVersion: 0,
        isTokenizing: false,
        isCompletingPayment: false,
        tokenizeCooldownUntil: 0,
        lastTerminalFailureAt: 0,
        spiEventsSubscribed: false,
        checkoutSaveWrapped: false,
        paymentSaveWrapped: false,
        renderPaymentFormTimer: null,
        uiRenderRetryScheduled: false,
        initialize: async function () {
            this.syncPaymentRuntimeVersion();
            if (!this.isAvailable && !document.getElementById('payment_form_bold')) {
                this.hidePaymentMethod();
                return;
            }
            await this.waitForPaymentFormDom();
            this.dedupePaymentFormBoldElements();
            this.refreshDomReferences();
            if (!this.getPaymentFormBold()) {
                this.schedulePaymentFormBootstrapRetry();
                return;
            }
            await this.waitForBaseInstance();
            if (!this.hasValidBaseInstance()) {
                this.schedulePaymentFormBootstrapRetry();
                return;
            }
            this.syncBoldAsCurrentPaymentMethod();
            this.subscribeToSpiEvents();
            this.waitForPaymentInitialization();
            this.waitForCheckoutInitialization();
            if (this.shouldShowBoldPaymentForm()) {
                this.ensurePaymentFormVisible();
                this.scheduleRenderPaymentForm(false, false);
            }
        },
        schedulePaymentFormBootstrapRetry: function () {
            if (this.bootstrapRetryTimer) {
                return;
            }
            let attempts = 0;
            const retry = async () => {
                this.bootstrapRetryTimer = null;
                if (!this.isCurrentRuntime()) {
                    return;
                }
                attempts += 1;
                await this.waitForPaymentFormDom();
                this.dedupePaymentFormBoldElements();
                this.refreshDomReferences();
                if (!this.getPaymentFormBold()) {
                    if (attempts < 50) {
                        this.bootstrapRetryTimer = setTimeout(retry, 200);
                    }
                    return;
                }
                await this.waitForBaseInstance();
                if (!this.hasValidBaseInstance()) {
                    if (attempts < 50) {
                        this.bootstrapRetryTimer = setTimeout(retry, 200);
                    }
                    return;
                }
                this.syncBoldAsCurrentPaymentMethod();
                if (this.isBoldPaymentActive()) {
                    this.ensurePaymentFormVisible();
                    this.scheduleRenderPaymentForm(true, false);
                }
            };
            this.bootstrapRetryTimer = setTimeout(retry, 200);
        },
        isBoldPaymentAvailableInCheckout: function () {
            return !!(document.getElementById('p_method_bold') || this.getPaymentFormBold());
        },
        shouldShowBoldPaymentForm: function () {
            if (!this.isBoldPaymentAvailableInCheckout()) {
                return false;
            }
            const boldInput = document.getElementById('p_method_bold');
            const methods = document.querySelectorAll('input[name="payment[method]"]');
            if (!methods.length) {
                return !!this.getPaymentFormBold();
            }
            if (!boldInput) {
                return false;
            }
            const otherMethodSelected = Array.from(methods).some(function (input) {
                return input.checked && input.value !== 'bold';
            });
            if (otherMethodSelected) {
                return false;
            }
            if (boldInput.checked) {
                return true;
            }
            if (methods.length === 1 && boldInput.value === 'bold') {
                return true;
            }
            if (typeof payment !== 'undefined' && payment.currentMethod === 'bold') {
                return true;
            }
            if (typeof payment !== 'undefined' && payment.lastUsedMethod === 'bold' && !otherMethodSelected) {
                return true;
            }
            return false;
        },
        isBoldPaymentActive: function () {
            return this.shouldShowBoldPaymentForm();
        },
        isSpiFrameReady: function () {
            const form = this.getPaymentFormBold();
            if (!form) {
                return false;
            }
            if (!this.shouldShowBoldPaymentForm() && form.style.display === 'none') {
                return false;
            }
            const frame = this.getActiveSpiFrame();
            return !!(frame && form.contains(frame) && frame.offsetHeight > 0);
        },
        isPaymentUiReady: function () {
            if (!this.isSpiFrameReady()) {
                return false;
            }
            if (this.shouldRenderCheckoutWalletButtons() && !this.hasRenderedPpcpButtons()) {
                return false;
            }
            return true;
        },
        shouldRenderCheckoutWalletButtons: function () {
            return this.shouldShowBoldPaymentForm();
        },
        shouldRenderSpi: function (hardReset) {
            if (hardReset) {
                return true;
            }
            const form = this.getPaymentFormBold();
            if (!form) {
                return false;
            }
            const frame = this.getActiveSpiFrame();
            if (!frame || !form.contains(frame)) {
                return true;
            }
            if (this.shouldShowBoldPaymentForm() && frame.offsetHeight <= 0) {
                return true;
            }
            return false;
        },
        shouldRenderWalletButtons: function (hardReset) {
            if (!this.shouldRenderCheckoutWalletButtons()) {
                return false;
            }
            if (hardReset) {
                return true;
            }
            return !this.hasRenderedPpcpButtons();
        },
        walletButtonsRenderScheduled: false,
        scheduleWalletButtonsRender: function () {
            if (!this.shouldRenderCheckoutWalletButtons() || this.walletButtonsRenderScheduled) {
                return;
            }
            this.walletButtonsRenderScheduled = true;
            const self = this;
            (async function () {
                try {
                    if (!self.isPaymentUiReady()) {
                        self.scheduleRenderPaymentForm(false, false);
                        await self.awaitPendingPaymentRender();
                        const deadline = Date.now() + 15000;
                        while (!self.isPaymentUiReady() && Date.now() < deadline) {
                            await self.delay(100);
                        }
                    }
                    if (self.isPaymentUiReady()) {
                        await self.ensurePpcpWalletButtons();
                    }
                } finally {
                    self.walletButtonsRenderScheduled = false;
                }
            })();
        },
        ensurePpcpWalletButtons: async function () {
            if (!this.isCurrentRuntime() || !this.hasValidBaseInstance() || !this.shouldRenderCheckoutWalletButtons()) {
                return;
            }
            if (this.hasRenderedPpcpButtons()) {
                return;
            }
            this.ensurePpcpButtonsContainer();
            const paymentInstance = await window.bold.baseInstance.getBoldPaymentsInstance();
            await this.renderPpcpWalletButtonsWithRetry(paymentInstance, false);
        },
        registerCheckoutWalletIntentListener: function () {
            if (window.bold.checkoutWalletIntentRegistered) {
                return;
            }
            window.bold.checkoutWalletIntentRegistered = true;
            document.observe('pointerdown', function (evt) {
                if (!evt.isTrusted) {
                    return;
                }
                const method = window.bold.boldPaymentMethod;
                if (!method || !method.shouldRenderCheckoutWalletButtons()) {
                    return;
                }
                const el = evt.element();
                if (!el || !el.closest) {
                    return;
                }
                if (el.closest('#smart-ppcp-buttons') || el.closest('.bold-checkout-wallet-buttons')) {
                    if (window.bold.baseInstance) {
                        window.bold.baseInstance.armWalletCheckoutCreate();
                    }
                    method.scheduleWalletButtonsRender();
                }
            });
        },
        syncBoldAsCurrentPaymentMethod: function () {
            const methods = Array.from(document.querySelectorAll('input[name="payment[method]"]'));
            const boldMethod = methods.find(function (input) {
                return input.value === 'bold';
            });
            if (!boldMethod) {
                return;
            }
            const otherMethodSelected = methods.some(function (input) {
                return input.checked && input.value !== 'bold';
            });
            if (otherMethodSelected) {
                return;
            }
            if (!boldMethod.checked) {
                boldMethod.checked = true;
            }
            if (typeof payment !== 'undefined' && payment.switchMethod && payment.currentMethod !== 'bold') {
                payment.switchMethod('bold');
            }
        },
        ensureBoldCheckoutUi: async function (options) {
            options = options || {};
            await this.waitForPaymentFormDom();
            this.dedupePaymentFormBoldElements();
            this.refreshDomReferences();
            if (!this.isBoldPaymentAvailableInCheckout()) {
                return;
            }
            if (!this.shouldShowBoldPaymentForm()) {
                this.hidePaymentFormWhenNotSelected();
                return;
            }
            this.syncBoldAsCurrentPaymentMethod();
            this.ensurePaymentFormVisible();
            if (!this.hasValidBaseInstance()) {
                await this.waitForBaseInstance();
            }
            if (!this.hasValidBaseInstance()) {
                return;
            }
            if (!options.hardReload && this.isPaymentUiReady()) {
                this.ensurePpcpButtonsContainer();
                return;
            }
            const needsRender = !!options.hardReload
                || (!!options.forceRender && !this.isPaymentUiReady());
            if (!needsRender) {
                return;
            }
            await this.awaitPendingPaymentRender();
            if (options.hardReload) {
                this.bumpPaymentRuntimeVersion();
                this.resetPaymentFlowState();
                if (typeof checkout !== 'undefined') {
                    checkout.setLoadWaiting(false);
                }
            }
            await this.renderPaymentForm(!!options.hardReload, !!options.hardReload);
            if (this.shouldShowBoldPaymentForm()) {
                this.ensurePaymentFormVisible();
            }
        },
        syncPaymentRuntimeVersion: function () {
            if (typeof window.bold.paymentRuntimeVersion !== 'number') {
                window.bold.paymentRuntimeVersion = 1;
            }
            this.paymentRuntimeVersion = window.bold.paymentRuntimeVersion;
        },
        bumpPaymentRuntimeVersion: function () {
            if (typeof window.bold.paymentRuntimeVersion !== 'number') {
                window.bold.paymentRuntimeVersion = 1;
            }
            window.bold.paymentRuntimeVersion += 1;
            this.paymentRuntimeVersion = window.bold.paymentRuntimeVersion;
            return this.paymentRuntimeVersion;
        },
        isCurrentRuntime: function () {
            return window.bold.boldPaymentMethod === this
                && this.paymentRuntimeVersion === window.bold.paymentRuntimeVersion;
        },
        resetPaymentFlowState: function () {
            this.paymentId = null;
            this.isTokenizing = false;
            this.isCompletingPayment = false;
        },
        canAttemptTokenize: function () {
            if (this.isTokenizing || this.isCompletingPayment) {
                return false;
            }
            if (this.tokenizeCooldownUntil && Date.now() < this.tokenizeCooldownUntil) {
                return false;
            }
            return true;
        },
        delay: function (ms) {
            return new Promise((resolve) => {
                setTimeout(resolve, ms);
            });
        },
        getPaymentMethodLoadRoot: function () {
            return document.getElementById('checkout-payment-method-load')
                || document.getElementById('payment-method');
        },
        getAllPaymentFormBoldElements: function () {
            return Array.from(document.querySelectorAll('[id="payment_form_bold"]'));
        },
        dedupePaymentFormBoldElements: function () {
            const forms = this.getAllPaymentFormBoldElements();
            if (forms.length <= 1) {
                return;
            }
            const root = this.getPaymentMethodLoadRoot();
            let keepForm = forms[forms.length - 1];
            if (root) {
                const inRoot = forms.filter((form) => root.contains(form));
                if (inRoot.length) {
                    keepForm = inRoot[inRoot.length - 1];
                }
            }
            forms.forEach((form) => {
                if (form !== keepForm) {
                    form.remove();
                }
            });
            document.querySelectorAll('[id="spi_frame_payment_form_bold"]').forEach((frame) => {
                if (!keepForm.contains(frame)) {
                    frame.remove();
                }
            });
        },
        getPaymentFormBold: function () {
            this.dedupePaymentFormBoldElements();
            const root = this.getPaymentMethodLoadRoot();
            if (root) {
                const inRoot = root.querySelector('[id="payment_form_bold"]');
                if (inRoot) {
                    return inRoot;
                }
            }
            const forms = this.getAllPaymentFormBoldElements();
            return forms.length ? forms[forms.length - 1] : null;
        },
        refreshDomReferences: function () {
            this.paymentCheckbox = document.getElementById('p_method_bold');
            this.paymentMethodElement = this.paymentCheckbox
                ? this.paymentCheckbox.parentNode
                : null;
        },
