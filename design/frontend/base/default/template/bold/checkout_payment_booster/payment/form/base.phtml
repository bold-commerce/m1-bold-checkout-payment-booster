                    window.bold.boldPaymentMethod.hidePaymentFormWhenNotSelected();
                }
            }
        });
        document.observe('firecheckout:paymentMethod:afterInitAfter', function () {
            const fastlanePm = window.bold.initBoldFastlanePaymentMethod();
            if (fastlanePm && fastlanePm.shouldShowFastlanePaymentForm()) {
                window.bold.refreshFastlanePaymentComponent();
            }
            const instance = window.bold.boldPaymentMethod;
            const showBold = instance && instance.shouldShowBoldPaymentForm();
            if (!showBold) {
                return;
            }
            if (instance.isPaymentUiReady()) {
                instance.revealPaymentFormWhenReady();
                window.bold.checkoutUiRenderState = 'ready';
                window.bold.markBoldPaymentUiRendered();
                return;
            }
            if (!window.bold.initialCheckoutUiRenderRequested) {
                window.bold.requestInitialCheckoutUiRender();
                return;
            }
            const renderState = window.bold.checkoutUiRenderState;
            if (renderState === 'pending' || renderState === 'rendering' || renderState === 'awaiting-wallets') {
                return;
            }
            if (window.bold.hasBoldPaymentUiRendered && !instance.getActiveSpiFrame() && !instance.isFastlaneAvailable) {
                window.bold.scheduleBoldPaymentSectionSync({hardReload: true});
            }
        });
        window.bold.registerPaymentMethodDomObserver = function () {
            if (window.bold.paymentMethodDomObserver) {
                return;
            }
            const root = document.getElementById('checkout-payment-method-load')
                || document.getElementById('payment-method');
            if (!root || typeof MutationObserver === 'undefined') {
                return;
            }
            window.bold.paymentMethodDomObserver = new MutationObserver(function () {
                // Initial render is owned by requestInitialCheckoutUiRender (FC: afterInitAfter).
            });
            window.bold.paymentMethodDomObserver.observe(root, {childList: true, subtree: true});
        };
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            window.bold.registerPaymentMethodDomObserver();
        } else {
            document.observe('dom:loaded', window.bold.registerPaymentMethodDomObserver);
        }
    }

    function boldBoosterBootstrap() {
        if (window.bold.boosterBootstrapped) {
            return;
        }
        window.bold.boosterBootstrapped = true;
        if (!window.bold.baseInstance) {
            window.bold.baseInstance = new BoldBase();
        }
        if (window.bold.baseInstance && typeof window.bold.baseInstance.prefetchCartData === 'function') {
            window.bold.baseInstance.prefetchCartData().catch(function (e) {
                console.warn('[Bold] Initial cart data prefetch failed', e);
            });
        }
        window.bold.initBoldPaymentMethod();
        if (typeof window.bold.registerPaymentMethodDomObserver === 'function') {
            window.bold.registerPaymentMethodDomObserver();
        }
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        boldBoosterBootstrap();
    } else {
        document.observe('dom:loaded', boldBoosterBootstrap);
    }
</script>
