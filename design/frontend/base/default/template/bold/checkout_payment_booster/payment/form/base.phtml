            instance.ensurePpcpButtonsContainer();
            return;
        }
        if (window.bold.paymentSyncInProgress) {
            if (!window.bold.pendingPaymentSectionSync) {
                window.bold.pendingPaymentSectionSync = {
                    hardReload: false,
                    forceRender: false
                };
            }
            if (options.hardReload) {
                window.bold.pendingPaymentSectionSync.hardReload = true;
            }
            if (options.forceRender) {
                window.bold.pendingPaymentSectionSync.forceRender = true;
            }
            return;
        }
        if (!window.bold.pendingPaymentSectionSync) {
            window.bold.pendingPaymentSectionSync = {
                hardReload: false,
                forceRender: false
            };
        }
        if (options.hardReload) {
            window.bold.pendingPaymentSectionSync.hardReload = true;
            window.bold.pendingPaymentSectionSync.forceRender = true;
        }
        if (options.forceRender) {
            window.bold.pendingPaymentSectionSync.forceRender = true;
        }
        if (window.bold.paymentSectionSyncTimer) {
            clearTimeout(window.bold.paymentSectionSyncTimer);
        }
        window.bold.paymentSectionSyncTimer = setTimeout(function () {
            window.bold.paymentSectionSyncTimer = null;
            window.bold.runBoldPaymentSectionSync();
        }, 350);
    };

    window.bold.runBoldPaymentSectionSync = async function () {
        const pending = window.bold.pendingPaymentSectionSync || {hardReload: false, forceRender: false};
        window.bold.pendingPaymentSectionSync = null;
        if (window.bold.paymentSyncInProgress) {
            return;
        }
        const instance = window.bold.ensureBoldPaymentRuntime();
        if (!instance) {
            return;
        }
        window.bold.paymentSyncInProgress = true;
        try {
            if (window.bold.baseInstance && typeof window.bold.baseInstance.getCartData === 'function') {
                try {
                    await window.bold.baseInstance.getCartData();
                } catch (e) {
                    console.warn('[Bold] Could not refresh cart data before checkout sync', e);
                }
            }
            await instance.ensureBoldCheckoutUi({
                hardReload: !!pending.hardReload,
                forceRender: !!pending.forceRender
            });
            instance.waitForPaymentInitialization();
            instance.waitForCheckoutInitialization();
            window.bold.lastPaymentSyncFinishedAt = Date.now();
            window.bold.lastSyncUiReady = instance.isPaymentUiReady();
        } catch (e) {
            console.error('[Bold] payment section sync failed', e);
        } finally {
            window.bold.paymentSyncInProgress = false;
            if (window.bold.pendingPaymentSectionSync) {
                const queued = window.bold.pendingPaymentSectionSync;
                window.bold.pendingPaymentSectionSync = null;
                if (!queued.hardReload && window.bold.lastSyncUiReady) {
                    return;
                }
                window.bold.scheduleBoldPaymentSectionSync(queued);
            }
        }
    };

    window.bold.handleFirecheckoutCheckoutChange = function (sections) {
        if (!window.bold.ensureBoldPaymentRuntime()) {
            return;
        }
        if (!sections) {
            window.bold.scheduleBoldPaymentSectionSync({forceRender: true});
            return;
        }
        if (sections['payment-method']) {
            window.bold.scheduleBoldPaymentSectionSync({hardReload: true});
            return;
        }
        const shouldSync = window.bold.checkoutSectionsTriggeringBoldSync.some(function (section) {
            return !!sections[section];
        });
        if (shouldSync) {
            window.bold.scheduleBoldPaymentSectionSync({forceRender: true});
        }
    };

    window.bold.onBoldPaymentFormInjected = function () {
        if (!window.bold.ensureBoldPaymentRuntime()) {
            return;
        }
        // Payment markup injection is followed by firecheckout:paymentMethod:afterInitAfter.
    };

    window.bold.handleFirecheckoutPaymentSectionReload = function () {
        if (!window.bold.ensureBoldPaymentRuntime()) {
            return;
        }
        window.bold.scheduleBoldPaymentSectionSync({hardReload: true});
    };

    window.bold.handleBoldPaymentMethodSelected = function () {
        const instance = window.bold.ensureBoldPaymentRuntime();
        if (!instance) {
            return;
        }
        instance.onBoldPaymentMethodSelected();
    };

    if (!window.bold.firecheckoutPaymentReloadRegistered) {
        window.bold.firecheckoutPaymentReloadRegistered = true;
        document.observe('firecheckout:setResponseAfter', function (e) {
            const sections = e.memo.response && e.memo.response.update_section;
            window.bold.handleFirecheckoutCheckoutChange(sections);
        });
        document.observe('payment-method:switched', function (e) {
            if (e.memo && e.memo.method_code === 'bold') {
                window.bold.handleBoldPaymentMethodSelected();
            }
        });
        document.observe('payment-method:switched-off', function (e) {
            if (e.memo && e.memo.method_code === 'bold' && window.bold.boldPaymentMethod) {
                if (!window.bold.boldPaymentMethod.shouldShowBoldPaymentForm()) {
                    window.bold.boldPaymentMethod.hidePaymentFormWhenNotSelected();
                }
            }
        });
        document.observe('firecheckout:paymentMethod:afterInitAfter', function () {
            const instance = window.bold.boldPaymentMethod;
            if (instance && instance.isPaymentUiReady()) {
                instance.ensurePaymentFormVisible();
                instance.ensurePpcpButtonsContainer();
                return;
            }
            window.bold.scheduleBoldPaymentSectionSync({hardReload: true});
        });
        window.bold.registerPaymentMethodDomObserver = function () {
            if (window.bold.paymentMethodDomObserver) {
                return;
            }
            const root = document.getElementById('checkout-payment-method-load')
                || document.getElementById('payment-method');
            if (!root || typeof MutationObserver === 'undefined') {
                return;
            }
            window.bold.paymentMethodDomObserver = new MutationObserver(function (mutations) {
                if (window.bold.spiRenderInProgress) {
                    return;
                }
                let formInjected = false;
                mutations.forEach(function (mutation) {
                    Array.from(mutation.addedNodes || []).forEach(function (node) {
                        if (node.nodeType !== 1) {
                            return;
                        }
                        if (node.id === 'payment_form_bold'
                            || (node.querySelector && node.querySelector('[id="payment_form_bold"]'))) {
                            formInjected = true;
                        }
                    });
                });
                if (formInjected && !window.bold.paymentSyncInProgress) {
                    window.bold.scheduleBoldPaymentSectionSync({hardReload: true});
                }
            });
            window.bold.paymentMethodDomObserver.observe(root, {childList: true, subtree: true});
        };
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            window.bold.registerPaymentMethodDomObserver();
        } else {
            document.observe('dom:loaded', window.bold.registerPaymentMethodDomObserver);
        }
    }

    function boldBoosterBootstrap() {
        window.bold.ensureBoldBaseInstance();
        window.bold.initBoldPaymentMethod();
        if (window.bold.boldPaymentMethod
            && typeof window.bold.boldPaymentMethod.registerCheckoutWalletIntentListener === 'function') {
            window.bold.boldPaymentMethod.registerCheckoutWalletIntentListener();
        }
        if (window.bold.baseInstance && typeof window.bold.baseInstance.prefetchCartData === 'function') {
            window.bold.baseInstance.prefetchCartData().catch(function (e) {
                console.warn('[Bold] Initial cart data prefetch failed', e);
            });
        }
        if (typeof window.bold.registerPaymentMethodDomObserver === 'function') {
            window.bold.registerPaymentMethodDomObserver();
        }
        window.bold.scheduleBoldPaymentSectionSync({forceRender: true});
    }

    window.bold.ensureBoldBaseInstance();

    if (!window.bold.firecheckoutCartPrefetchRegistered) {
        window.bold.firecheckoutCartPrefetchRegistered = true;
        document.observe('firecheckout:setResponseAfter', function () {
            if (window.bold.baseInstance && typeof window.bold.baseInstance.prefetchCartData === 'function') {
                window.bold.baseInstance.prefetchCartData().catch(function (e) {
                    console.warn('[Bold] Firecheckout cart data prefetch failed', e);
                });
            }
        });
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        boldBoosterBootstrap();
    } else {
        document.observe('dom:loaded', boldBoosterBootstrap);
    }
</script>
