<?php
/**
 * @var Bold_CheckoutPaymentBooster_Block_Payment_Form_Base $this
 */
?>

<script type="text/javascript">
    /**
     * Bold Payments base class.
     */
    const BoldBase = Class.create({
        boldPaymentsInstance: null,
        authorizedEmail: null,
        fastlaneInstance: null,
        fastlaneProfileData: null,
        gatewayData: null,
        buildFastlaneInstanceInProgress: false,
        buildPaymentsInstanceInProgress: false,
        isAvailable: <?php echo $this->isAvailable(); ?>,
        groupLabel: '<?php echo $this->getGroupLabel() ?>',
        boldApiUrl: '<?php echo $this->getBoldApiUrl(); ?>',
        jwtToken: '<?php echo $this->getJwtToken(); ?>',
        epsAuthToken: '<?php echo $this->getEpsAuthToken(); ?>',
        epsUrl: '<?php echo $this->getEpsUrl(); ?>',
        epsStaticUrl: '<?php echo $this->getEpsStaticUrl(); ?>',
        epsGatewayId: '<?php echo $this->getEpsGatewayId(); ?>',
        quoteCurrencyCode: '<?php echo $this->getQuoteCurrencyCode(); ?>',
        isFastlaneAvailable: <?php echo $this->isFastlaneAvailable(); ?>,
        billingAddressFieldsMap: {
            'firstname': 'billing:firstname',
            'lastname': 'billing:lastname',
            'company': 'billing:company',
            'telephone': 'billing:telephone',
            'street1': 'billing:street1',
            'street2': 'billing:street2',
            'city': 'billing:city',
            'region_id': 'billing:region_id',
            'country_id': 'billing:country_id',
            'postcode': 'billing:postcode',
            'use_for_shipping': 'billing:use_for_shipping_yes'
        },
        /**
         * Initialize class.
         *
         * @returns {*|boolean}
         */
        initialize: async function () {
            if (!this.isAvailable) {
                return false;
            }
            if (!this.isFastlaneAvailable) {
                return;
            }
            this.renderFastlaneWatermark();
            await this.authorizeFastlaneUser();
            this.subscribeToEmailChanges();
        },
        /**
         * Observe email changes to authorize Fastlane user.
         *
         * @return {void}
         */
        subscribeToEmailChanges: function () {
            const emailField = this.getEmailField();
            if (!emailField) {
                return;
            }
            emailField.observe('change', () => {
                setTimeout(async () => {
                    await this.authorizeFastlaneUser();
                }, 500);
            });
        },
        /**
         * Remove Fastlane watermark placeholder in case fastlane is not available.
         *
         * @return {void}
         */
        removeWatermarkPlaceholder: function () {
            const watermarkContainer = document.getElementById('fastlane-watermark-container');
            if (watermarkContainer) {
                watermarkContainer.remove();
            }
        },
        /**
         * Render Fastlane watermark.
         *
         * @return {void}
         */
        renderFastlaneWatermark: async function () {
            this.renderFastlaneWatermarkPlaceholder();
            const fastlaneInstance = await this.getFastlaneInstance();
            const watermarkComponent = await fastlaneInstance.FastlaneWatermarkComponent({includeAdditionalInfo: true});
            let watermarkContainer = document.getElementById('fastlane-email-watermark-container');
            if (watermarkContainer) {
                watermarkContainer.style = 'float: right';
                watermarkComponent.render('#fastlane-email-watermark-container');
            }
        },
        /**
         * Render Fastlane watermark placeholder to show watermark immediately before fastlane is initialize.
         *
         * @return {void}
         */
        renderFastlaneWatermarkPlaceholder: function () {
            const emailField = this.getEmailField();
            if (!emailField) {
                return;
            }
            const watermarkContainerId = 'fastlane-watermark-container';
            const existingWatermarkContainer = document.getElementById(watermarkContainerId);
            if (existingWatermarkContainer) {
                return;
            }
            const watermarkContainer = document.createElement('div');
            const watermarkSubContainer = document.createElement('div');
            const watermark = document.createElement('img');
            watermarkSubContainer.id = 'fastlane-email-watermark-container';
            watermarkSubContainer.style = 'float: right; margin-top: 5px';
            watermark.src = 'https://www.paypalobjects.com/connect-boba/assets/FastLaneLogoSmall.svg';
            watermark.alt = '';
            watermarkSubContainer.appendChild(watermark);
            watermarkContainer.id = watermarkContainerId;
            watermarkContainer.style = '<?php echo $this->getWatermarkContainerStyle(); ?>';
            watermarkContainer.appendChild(watermarkSubContainer);
            emailField.insertAdjacentElement('afterend', watermarkContainer);
        },
        /**
         * Build Fastlane Instance considering gateway type.
         *
         * @return {Promise<{}>}
         */
        getFastlaneInstance: async function () {
            if (this.fastlaneInstance) {
                this.buildFastlaneInstanceInProgress = false;
                return this.fastlaneInstance;
            }
            if (this.buildFastlaneInstanceInProgress) {
                return new Promise((resolve) => {
                    setTimeout(() => {
                        resolve(this.getFastlaneInstance());
                    }, 500);
                });
            }
            this.buildFastlaneInstanceInProgress = true;
            const boldPaymentsInstance = await this.getBoldPaymentsInstance();
            const fastlaneClient = await boldPaymentsInstance.getFastlaneClientInit({
                shouldLoadScript: true
            });
            this.gatewayData = fastlaneClient[this.epsGatewayId] || null;
            if (!this.gatewayData) {
                return null;
            }
            if (this.gatewayData.is_test_mode) {
                window.localStorage.setItem('axoEnv', 'sandbox');
                window.localStorage.setItem('fastlaneEnv', 'sandbox');
            }
            if (this.gatewayData.type === 'braintree') {
                this.fastlaneInstance = await this.buildBraintreeFastlaneInstance();
            }
            if (this.gatewayData.type === 'ppcp') {
                this.fastlaneInstance = await this.buildPpcpFastlaneInstance();
            }
            this.buildFastlaneInstanceInProgress = false;
            return this.fastlaneInstance;
        },
        /**
         * Build Fastlane Instance for the Braintree.
         *
         * @return {Promise<void>}
         */
        buildBraintreeFastlaneInstance: async function () {
            await this.loadScript(
                'https://js.braintreegateway.com/web/3.106.0/js/client.min.js'
            );
            await this.loadScript(
                'https://js.braintreegateway.com/web/3.106.0/js/data-collector.min.js'
            );
            await this.loadScript(
                'https://js.braintreegateway.com/web/3.106.0/js/hosted-fields.min.js'
            );
            await this.loadScript(
                'https://js.braintreegateway.com/web/3.106.0/js/fastlane.min.js'
            );
            const clientInstance = await window.braintree.client.create({
                authorization: this.gatewayData.client_token,
            });
            const dataCollectorInstance = await window.braintree.dataCollector.create(
                {
                    client: clientInstance,
                }
            );
            const {deviceData} = dataCollectorInstance;
            return window.braintree.fastlane.create({
                authorization: this.gatewayData.client_token,
                client: clientInstance,
                deviceData: deviceData,
            });
        },
        /**
         * Build Fastlane Instance for the PPCP.
         *
         * @return {Promise<{}>}
         * @private
         */
        buildPpcpFastlaneInstance: async function () {
            return window.paypal.Fastlane();
        },
        /**
         * Authorize user with email.
         *
         * @return {Promise<void>}
         */
        authorizeFastlaneUser: async function () {
            const emailField = this.getEmailField();
            if (!emailField || !emailField.value || this.authorizedEmail === emailField.value) {
                return;
            }
            if (!window.Validation.validate(emailField)) {
                return;
            }
            checkout.setLoadWaiting('billing', true);
            this.authorizedEmail = emailField.value;
            try {
                const {identity} = await this.getFastlaneInstance();
                const {customerContextId} = await identity.lookupCustomerByEmail(emailField.value);
                checkout.setLoadWaiting(false);
                if (!customerContextId) {
                    this.removeAddressButton();
                    this.fastlaneProfileData = null;
                    if (window.bold.fastlanePaymentMethod) {
                        window.bold.fastlanePaymentMethod.renderFastlanePaymentComponent();
                    }
                    return;
                }
                const {
                    authenticationState,
                    profileData
                } = await identity.triggerAuthenticationFlow(customerContextId);
                if (authenticationState === 'succeeded') {
                    checkout.setLoadWaiting('billing', true);
                    this.fastlaneProfileData = profileData;
                    if (profileData.shippingAddress) {
                        this.updateBillingAddressFormValues(profileData.shippingAddress);
                        this.addAddressButton();
                    }
                    if (window.bold.fastlanePaymentMethod) {
                        window.bold.fastlanePaymentMethod.selectPaymentMethod();
                        window.bold.fastlanePaymentMethod.renderFastlanePaymentComponent();
                    }
                    checkout.setLoadWaiting(false);
                }
            } catch (error) {
                console.error('Error:', error);
            }
        },
        /**
         * Fill billing address form with Fastlane address.
         *
         * @param {{}} fastlaneAddress
         * @return {void}
         */
        updateBillingAddressFormValues: function (fastlaneAddress) {
            const magentoAddress = this.convertFastlaneAddressToMagentoAddress(fastlaneAddress);
            Object.keys(this.billingAddressFieldsMap).forEach((field) => {
                if (magentoAddress[field] && document.getElementById(this.billingAddressFieldsMap[field])) {
                    const element = document.getElementById(this.billingAddressFieldsMap[field]);
                    if (!element) {
                        return;
                    }
                    element.value = magentoAddress[field];
                }
            });
        },
        /**
         * Convert Fastlane address to Magento address.
         *
         * @param fastlaneAddress {{}}
         * @return {{}}
         */
        convertFastlaneAddressToMagentoAddress: function (fastlaneAddress) {
            let magentoAddressRegionId = null;
            const fastlaneCountryCode = fastlaneAddress.countryCodeAlpha2 || fastlaneAddress.address?.countryCode;
            const fastlaneRegionCode = fastlaneAddress.region || fastlaneAddress.address?.adminArea1;
            if (window.billingRegionUpdater.regions[fastlaneCountryCode]) {
                Object.entries(window.billingRegionUpdater.regions[fastlaneCountryCode]).each((region) => {
                    const [regionId, regionData] = region;
                    if (regionData.code === fastlaneRegionCode) {
                        magentoAddressRegionId = regionId;
                    }
                })
            }
            const telephone = typeof fastlaneAddress.phoneNumber === 'string'
                ? fastlaneAddress.phoneNumber
                : fastlaneAddress.phoneNumber?.countryCode + fastlaneAddress.phoneNumber?.nationalNumber;
            return {
                'firstname': fastlaneAddress.firstName || fastlaneAddress.name?.firstName,
                'lastname': fastlaneAddress.lastName || fastlaneAddress.name?.lastName,
                'company': fastlaneAddress.company,
                'telephone': telephone,
                'street1': fastlaneAddress.streetAddress || fastlaneAddress.address?.addressLine1,
                'street2': fastlaneAddress.extendedAddress || fastlaneAddress.address?.addressLine2,
                'city': fastlaneAddress.locality || fastlaneAddress.address?.adminArea2,
                'region_id': magentoAddressRegionId,
                'postcode': fastlaneAddress.postalCode || fastlaneAddress.address?.postalCode,
                'country_id': fastlaneCountryCode,
            };
        },
        /**
         * Remove change address button from billing address form.
         *
         * @return {void}
         */
        removeAddressButton: function () {
            const fastlaneAddressContainer = document.getElementById('fastlane-address-container');
            if (fastlaneAddressContainer) {
                fastlaneAddressContainer.remove();
            }
        },
        /**
         * Add change address button on billing address form.
         *
         * @return {{}}
         */
        addAddressButton: function () {
            this.removeAddressButton();
            const fastlaneAddressContainer = document.createElement('fieldset');
            fastlaneAddressContainer.id = 'fastlane-address-container';
            fastlaneAddressContainer.style = '<?php echo $this->getAddressContainerStyle(); ?>';
            const updateAddressButton = document.createElement('button');
            updateAddressButton.type = 'button';
            updateAddressButton.className = 'button';
            updateAddressButton.innerHTML = 'Change Address';
            updateAddressButton.addEventListener('click', () => {
                this.getFastlaneInstance().then((fastlaneInstance) => {
                    if (!fastlaneInstance) {
                        return;
                    }
                    fastlaneInstance.profile.showShippingAddressSelector().then((editAddressResult) => {
                        if (!editAddressResult.selectionChanged) {
                            return;
                        }
                        this.updateBillingAddressFormValues(editAddressResult.selectedAddress);
                    });
                });
            });
            fastlaneAddressContainer.appendChild(updateAddressButton);
            const billingAddressForm = document.getElementById('billing-new-address-form');
            if (billingAddressForm) {
                billingAddressForm.appendChild(fastlaneAddressContainer);
            }
        },
        /**
         * Load SPI SDK.
         *
         * @returns {Promise<void>}
         */
        getBoldPaymentsInstance: async function () {
            if (this.boldPaymentsInstance) {
                this.buildPaymentsInstanceInProgress = false;
                return this.boldPaymentsInstance;
            }
            if (this.buildPaymentsInstanceInProgress) {
                return new Promise((resolve) => {
                    setTimeout(() => {
                        resolve(this.getBoldPaymentsInstance());
                    }, 500);
                });
            }
            this.buildPaymentsInstanceInProgress = true;
            await this.loadScript(this.epsStaticUrl + '/js/payments_sdk.js');
            const initialData = {
                'eps_url': this.epsUrl,
                'eps_bucket_url': this.epsStaticUrl,
                'group_label': this.groupLabel,
                'trace_id': '<?php echo $this->getPublicOrderID(); ?>',
                'payment_gateways': [
                    {
                        'gateway_id': Number(this.epsGatewayId),
                        'auth_token': this.epsAuthToken,
                        'currency': this.quoteCurrencyCode,
                    }
                ],
                'callbacks': {
                    'onCreatePaymentOrder': async function (paymentType, paymentPayload) {
                        if (paymentType !== 'ppcp') {
                            return;
                        }
                        try {
                            const createOrderResult = await this.createExpressOrder(paymentPayload);
                            return {payment_data: {id: createOrderResult.order_id}};
                        } catch (e) {
                            console.error('Failed to create express order', e);
                            throw e;
                        }
                    }.bind(this),
                    'onUpdatePaymentOrder': async function () {
                        // We won't handle updating an order from PayPal data, we will disable address changes etc
                    }.bind(this),
                    'onApprovePaymentOrder': async function (paymentType, paymentInformation) {
                        // A PayPal payment has been completed, we need to capture the payment ID and pass it through
                        if (paymentType !== 'ppcp') {
                            return;
                        }
                        if (!paymentInformation.payment_id) {
                            console.error('No payment ID provided from PayPal.');
                            return;
                        }
                        window.bold.boldPaymentMethod.paymentId = paymentInformation.payment_id;
                        payment.save();
                    }.bind(this),
                    'onScaPaymentOrder': async function (type, payload) {
                        if (type !== 'ppcp') {
                            throw new Error('Unsupported payment type');
                        }
                        const url = `${this.boldApiUrl}payments/on_sca`;
                        const orderId = payload.order_id;
                        const scaResult = await fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${this.jwtToken}`
                            },
                            body: JSON.stringify(
                                {
                                    'order_id': orderId,
                                    'public_order_id': '<?php echo $this->getPublicOrderID(); ?>',
                                    'gateway_type': 'ppcp',
                                }
                            ),
                        });
                        if (!scaResult.ok) {
                            throw new Error('SCA failed');
                        }
                        const data = await scaResult.json();
                        return {card: data};
                    }.bind(this),
                    'onRequireOrderData': async function (requirements) {
                        try {
                            return await this.onRequireOrderDataCallback(requirements);
                        } catch (e) {
                            checkout.setLoadWaiting('billing', false);
                            throw e;
                        }
                    }.bind(this),
                }
            };
            this.boldPaymentsInstance = new window.bold.Payments(initialData);
            this.buildPaymentsInstanceInProgress = false;
            return this.boldPaymentsInstance;
        },
        /**
         * Reset cached Payments SDK so SPI can render again after DOM teardown.
         *
         * @return {void}
         */
        resetPaymentsInstance: function () {
            this.boldPaymentsInstance = null;
            this.buildPaymentsInstanceInProgress = false;
        },
        /**
         * Load specified script with attributes.
         *
         * @param {string} src
         * @param {Object} attributes
         * @returns {Promise<void>}
         * @private
         */
        loadScript: async function (src, attributes = {}) {
            return new Promise((resolve, reject) => {
                const script = document.createElement('script');
                script.src = src;
                script.async = true;
                script.onload = resolve;
                script.onerror = reject;
                if (attributes.constructor === Object) {
                    Object.keys(attributes).forEach((key) => {
                        script.setAttribute(key, attributes[key]);
                    });
                }
                document.head.appendChild(script);
            });
        },
        /**
         * Get email field.
         *
         * @return {HTMLElement}
         * @private
         */
        getEmailField: function () {
            return document.getElementById('billing:email');
        },
        /**
         * Pull cart data from backend.
         *
         * @returns {Promise<{}>}
         */
        getCartData: async function () {
            return new Promise((resolve, reject) => {
                new Ajax.Request('/checkoutpaymentbooster/index/getCartData', {
                    method: 'get',
                    parameters: {form_key: '<?php echo Mage::getSingleton('core/session')->getFormKey() ?>'},
                    onSuccess: function (response) {
                        resolve(JSON.parse(response.responseText));
                    },
                    onFailure: function () {
                        reject(new Error('Failed to get cart data'));
                    }
                });
            });
        },
        /**
         * Call backend to create express order.
         *
         * @param paymentPayload
         * @return {Promise<unknown>}
         */
        createExpressOrder: async function (paymentPayload) {
            return new Promise((resolve, reject) => {
                new Ajax.Request('/checkoutpaymentbooster/expresspay/createOrder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    parameters: {
                        form_key: '<?php echo Mage::getSingleton('core/session')->getFormKey() ?>',
                        quote_id: '<?php echo $this->getQuoteId(); ?>',
                        gateway_id: paymentPayload.gateway_id,
                        shipping_strategy: paymentPayload.shipping_strategy || 'dynamic'
                    },
                    onSuccess: function (response) {
                        resolve(JSON.parse(response.responseText));
                    },
                    onFailure: function () {
                        reject(new Error('Failed to create express order'));
                    }
                });
            });
        },
        /**
         * Handle order data requirements.
         *
         * @param requirements
         * @return {Promise<{}>}
         */
        onRequireOrderDataCallback: async function (requirements) {
            const orderData = {};
            const cartData = await this.getCartData();
            for (const requirement of requirements) {
                switch (requirement) {
                    case 'customer':
                        let billingAddress = cartData.billingAddress();
                        const email = cartData.customer.email;

                        orderData[requirement] = {
                            first_name: billingAddress.firstname,
                            last_name: billingAddress.lastname,
                            email_address: email,
                        };
                        break;
                    case 'items':
                        orderData[requirement] = cartData.cart_items.map(item => ({
                            amount: item.price,
                            label: item.title
                        }));
                        break;
                    case 'billing_address':
                        orderData[requirement] = cartData.billing_address;
                        break;
                    case 'shipping_address':
                        orderData[requirement] = cartData.shipping_address;
                        break;
                    case 'shipping_options':
                        orderData[requirement] = cartData.shipping_options;
                        break;
                    case 'totals':
                        const totals = cartData.totals;
                        orderData[requirement] = {
                            order_total: totals.order_total,
                            shipping_total: totals.shipping_total,
                            discounts_total: totals.discount_total,
                            fees_total: totals.fee_total || 0,
                            taxes_total: totals.tax_total,
                        };
                        break;
                }
            }
            return orderData;
        },

    });

    /**
     * Bold payment method — single instance in base.phtml (Firecheckout AJAX reloads bold_method markup only).
     */
    const BoldPaymentMethod = Class.create({
        paymentMethodElement: null,
        paymentCheckbox: null,
        isAvailable: <?php echo $this->isAvailable(); ?>,
        isFastlaneAvailable: <?php echo $this->isFastlaneAvailable(); ?>,
        paymentId: null,
        paymentRuntimeVersion: 0,
        isTokenizing: false,
        isCompletingPayment: false,
        tokenizeCooldownUntil: 0,
        lastTerminalFailureAt: 0,
        spiEventsSubscribed: false,
        checkoutSaveWrapped: false,
        paymentSaveWrapped: false,
        renderPaymentFormTimer: null,
        initialize: async function () {
            this.syncPaymentRuntimeVersion();
            if (!this.isAvailable) {
                this.hidePaymentMethod();
                return;
            }
            await this.waitForPaymentFormDom();
            this.dedupePaymentFormBoldElements();
            this.refreshDomReferences();
            if (!this.getPaymentFormBold()) {
                return;
            }
            await this.waitForBaseInstance();
            if (!this.hasValidBaseInstance()) {
                return;
            }
            this.subscribeToSpiEvents();
            this.waitForPaymentInitialization();
            this.waitForCheckoutInitialization();
            this.scheduleRenderPaymentForm(true);
        },
        syncPaymentRuntimeVersion: function () {
            if (typeof window.bold.paymentRuntimeVersion !== 'number') {
                window.bold.paymentRuntimeVersion = 1;
            }
            this.paymentRuntimeVersion = window.bold.paymentRuntimeVersion;
        },
        bumpPaymentRuntimeVersion: function () {
            if (typeof window.bold.paymentRuntimeVersion !== 'number') {
                window.bold.paymentRuntimeVersion = 1;
            }
            window.bold.paymentRuntimeVersion += 1;
            this.paymentRuntimeVersion = window.bold.paymentRuntimeVersion;
            return this.paymentRuntimeVersion;
        },
        isCurrentRuntime: function () {
            return window.bold.boldPaymentMethod === this
                && this.paymentRuntimeVersion === window.bold.paymentRuntimeVersion;
        },
        resetPaymentFlowState: function () {
            this.paymentId = null;
            this.isTokenizing = false;
            this.isCompletingPayment = false;
        },
        canAttemptTokenize: function () {
            if (this.isTokenizing || this.isCompletingPayment) {
                return false;
            }
            if (this.tokenizeCooldownUntil && Date.now() < this.tokenizeCooldownUntil) {
                return false;
            }
            return true;
        },
        delay: function (ms) {
            return new Promise((resolve) => {
                setTimeout(resolve, ms);
            });
        },
        getPaymentMethodLoadRoot: function () {
            return document.getElementById('checkout-payment-method-load')
                || document.getElementById('payment-method');
        },
        getAllPaymentFormBoldElements: function () {
            return Array.from(document.querySelectorAll('[id="payment_form_bold"]'));
        },
        dedupePaymentFormBoldElements: function () {
            const forms = this.getAllPaymentFormBoldElements();
            if (forms.length <= 1) {
                return;
            }
            const root = this.getPaymentMethodLoadRoot();
            let keepForm = forms[forms.length - 1];
            if (root) {
                const inRoot = forms.filter((form) => root.contains(form));
                if (inRoot.length) {
                    keepForm = inRoot[inRoot.length - 1];
                }
            }
            forms.forEach((form) => {
                if (form !== keepForm) {
                    form.remove();
                }
            });
            document.querySelectorAll('[id="spi_frame_payment_form_bold"]').forEach((frame) => {
                if (!keepForm.contains(frame)) {
                    frame.remove();
                }
            });
        },
        getPaymentFormBold: function () {
            this.dedupePaymentFormBoldElements();
            const root = this.getPaymentMethodLoadRoot();
            if (root) {
                const inRoot = root.querySelector('[id="payment_form_bold"]');
                if (inRoot) {
                    return inRoot;
                }
            }
            const forms = this.getAllPaymentFormBoldElements();
            return forms.length ? forms[forms.length - 1] : null;
        },
        refreshDomReferences: function () {
            this.paymentCheckbox = document.getElementById('p_method_bold');
            this.paymentMethodElement = this.paymentCheckbox
                ? this.paymentCheckbox.parentNode
                : null;
        },
        waitForPaymentFormDom: function () {
            return new Promise((resolve) => {
                if (this.getPaymentFormBold()) {
                    resolve();
                    return;
                }
                const intervalId = setInterval(() => {
                    if (this.getPaymentFormBold()) {
                        clearInterval(intervalId);
                        resolve();
                    }
                }, 100);
                setTimeout(() => {
                    clearInterval(intervalId);
                    resolve();
                }, 10000);
            });
        },
        hasValidBaseInstance: function () {
            return window.bold
                && window.bold.baseInstance
                && typeof window.bold.baseInstance.getBoldPaymentsInstance === 'function';
        },
        waitForBaseInstance: function () {
            return new Promise((resolve) => {
                if (this.hasValidBaseInstance()) {
                    resolve();
                    return;
                }
                const intervalId = setInterval(() => {
                    if (this.hasValidBaseInstance()) {
                        clearInterval(intervalId);
                        resolve();
                    }
                }, 100);
                setTimeout(() => {
                    clearInterval(intervalId);
                    resolve();
                }, 10000);
            });
        },
        getActiveSpiFrame: function () {
            const form = this.getPaymentFormBold();
            return form ? form.querySelector('[id="spi_frame_payment_form_bold"]') : null;
        },
        getPpcpButtonsContainer: function () {
            const form = this.getPaymentFormBold();
            return form ? form.querySelector('[id="smart-ppcp-buttons"]') : document.getElementById('smart-ppcp-buttons');
        },
        ensurePpcpButtonsContainer: function () {
            const form = this.getPaymentFormBold();
            if (!form) {
                return null;
            }
            let host = this.getPpcpButtonsContainer();
            if (!host) {
                host = document.createElement('div');
                host.id = 'smart-ppcp-buttons';
                host.className = 'bold-ppcp-wallet-host';
                const inner = document.createElement('div');
                inner.id = 'paypal-button-container';
                host.appendChild(inner);
            } else if (!host.querySelector('[id="paypal-button-container"]')) {
                const inner = document.createElement('div');
                inner.id = 'paypal-button-container';
                host.appendChild(inner);
            }
            if (host.parentNode !== form) {
                form.appendChild(host);
            }
            const spiFrame = this.getActiveSpiFrame();
            if (spiFrame && host.nextSibling !== spiFrame) {
                form.insertBefore(host, spiFrame);
            } else if (!spiFrame && form.firstChild !== host) {
                form.insertBefore(host, form.firstChild);
            }
            host.style.display = '';
            return host;
        },
        clearPpcpButtonsContent: function () {
            const host = this.getPpcpButtonsContainer();
            if (!host) {
                return;
            }
            const inner = host.querySelector('[id="paypal-button-container"]') || host;
            while (inner.firstChild) {
                inner.removeChild(inner.firstChild);
            }
        },
        hasRenderedPpcpButtons: function () {
            const host = this.getPpcpButtonsContainer();
            if (!host) {
                return false;
            }
            const inner = host.querySelector('[id="paypal-button-container"]') || host;
            if (inner.children.length > 0) {
                return true;
            }
            return !!host.querySelector('iframe, [data-funding-source], .paypal-buttons, button, [role="button"]');
        },
        needsPpcpButtonsRender: function () {
            return !!this.getPaymentFormBold() && !this.hasRenderedPpcpButtons();
        },
        dedupeSpiFrames: function () {
            const form = this.getPaymentFormBold();
            if (!form) {
                return;
            }
            const frames = Array.from(form.querySelectorAll('[id="spi_frame_payment_form_bold"]'));
            frames.slice(0, -1).forEach((frame) => frame.remove());
        },
        clearSpiFromDom: function () {
            const form = this.getPaymentFormBold();
            if (!form) {
                return;
            }
            const hadSpi = !!this.getActiveSpiFrame();
            Array.from(form.children).forEach((child) => {
                if (child.id === 'smart-ppcp-buttons') {
                    this.clearPpcpButtonsContent();
                    return;
                }
                child.remove();
            });
            this.dedupeSpiFrames();
            if (hadSpi && window.bold.baseInstance) {
                window.bold.baseInstance.resetPaymentsInstance();
            }
        },
        isSpiAlreadyRenderedError: function (error) {
            const message = error && error.message ? error.message : String(error);
            return message.indexOf('SPI frame is already rendered') !== -1;
        },
        isPaymentRenderReady: function () {
            return !!this.getActiveSpiFrame();
        },
        canSkipPaymentRender: function (forceReset) {
            if (forceReset || !this.isCurrentRuntime()) {
                return false;
            }
            if (!this.isPaymentRenderReady()) {
                return false;
            }
            if (this.needsPpcpButtonsRender()) {
                return false;
            }
            return true;
        },
        awaitPendingPaymentRender: function () {
            if (window.bold.paymentRenderPromise) {
                return window.bold.paymentRenderPromise.catch(function () {});
            }
            return Promise.resolve();
        },
        renderPpcpWalletButtons: async function (paymentInstance, force) {
            if (!paymentInstance || typeof paymentInstance.renderWalletPayments !== 'function') {
                return false;
            }
            if (force) {
                this.clearPpcpButtonsContent();
            } else if (!this.needsPpcpButtonsRender()) {
                return this.hasRenderedPpcpButtons();
            }
            this.ensurePpcpButtonsContainer();
            const shopName = window.bold.baseInstance && window.bold.baseInstance.groupLabel
                ? window.bold.baseInstance.groupLabel
                : '';
            try {
                await paymentInstance.renderWalletPayments('smart-ppcp-buttons', {
                    allowedCountries: ['US', 'CA'],
                    fastlane: !!this.isFastlaneAvailable,
                    isPhoneRequired: true,
                    pageSource: 'checkout',
                    shopName: shopName
                });
                return this.hasRenderedPpcpButtons();
            } catch (e) {
                console.warn('[Bold] renderWalletPayments failed', e);
                return false;
            }
        },
        renderPpcpWalletButtonsWithRetry: async function (paymentInstance, force) {
            const maxAttempts = force ? 3 : 1;
            for (let attempt = 0; attempt < maxAttempts; attempt++) {
                if (!this.isCurrentRuntime()) {
                    return;
                }
                const rendered = await this.renderPpcpWalletButtons(paymentInstance, !!force);
                if (rendered) {
                    return;
                }
                if (attempt < maxAttempts - 1) {
                    await this.delay(300);
                }
            }
        },
        scheduleRenderPaymentForm: function (immediate, forceReset) {
            if (typeof window.bold.spiRenderGeneration !== 'number') {
                window.bold.spiRenderGeneration = 0;
            }
            window.bold.spiRenderGeneration += 1;
            const generation = window.bold.spiRenderGeneration;
            if (this.renderPaymentFormTimer) {
                clearTimeout(this.renderPaymentFormTimer);
                this.renderPaymentFormTimer = null;
            }
            const run = () => {
                if (generation !== window.bold.spiRenderGeneration) {
                    return;
                }
                this.renderPaymentForm(!!forceReset);
            };
            if (immediate) {
                run();
            } else {
                this.renderPaymentFormTimer = setTimeout(run, 500);
            }
        },
        renderPaymentForm: async function (forceReset) {
            if (!this.isCurrentRuntime() || !this.hasValidBaseInstance()) {
                return;
            }
            const form = this.getPaymentFormBold();
            if (!form) {
                return;
            }
            if (this.canSkipPaymentRender(forceReset)) {
                return;
            }
            await this.awaitPendingPaymentRender();
            if (!this.isCurrentRuntime() || this.canSkipPaymentRender(forceReset)) {
                return;
            }
            const renderVersion = this.paymentRuntimeVersion;
            const renderTask = (async () => {
                window.bold.spiRenderInProgress = true;
                try {
                    if (forceReset) {
                        this.clearSpiFromDom();
                        if (window.bold.baseInstance) {
                            window.bold.baseInstance.resetPaymentsInstance();
                            await this.delay(200);
                        }
                    }
                    if (!this.isCurrentRuntime() || renderVersion !== this.paymentRuntimeVersion) {
                        return;
                    }
                    const paymentInstance = await window.bold.baseInstance.getBoldPaymentsInstance();
                    if (!this.isCurrentRuntime() || renderVersion !== this.paymentRuntimeVersion) {
                        return;
                    }
                    this.ensurePpcpButtonsContainer();
                    const shouldRenderSpi = forceReset || !this.getActiveSpiFrame();
                    if (!this.isFastlaneAvailable && shouldRenderSpi) {
                        try {
                            await paymentInstance.renderPayments('payment_form_bold', {
                                fastlane: false,
                                shouldRenderSpiFrame: true
                            });
                        } catch (e) {
                            if (this.isSpiAlreadyRenderedError(e)) {
                                if (!this.getActiveSpiFrame() && window.bold.baseInstance) {
                                    window.bold.baseInstance.resetPaymentsInstance();
                                    await this.delay(200);
                                    const retryInstance = await window.bold.baseInstance.getBoldPaymentsInstance();
                                    await retryInstance.renderPayments('payment_form_bold', {
                                        fastlane: false,
                                        shouldRenderSpiFrame: true
                                    });
                                } else {
                                    console.warn('[Bold] SPI frame already rendered, reusing existing frame');
                                    this.dedupeSpiFrames();
                                }
                            } else {
                                throw e;
                            }
                        }
                    } else if (this.isFastlaneAvailable && shouldRenderSpi) {
                        await paymentInstance.renderPayments('payment_form_bold', {
                            fastlane: true,
                            shouldRenderSpiFrame: false
                        });
                    }
                    if (!this.isCurrentRuntime() || renderVersion !== this.paymentRuntimeVersion) {
                        return;
                    }
                    this.dedupeSpiFrames();
                    await this.renderPpcpWalletButtonsWithRetry(paymentInstance, forceReset);
                } finally {
                    window.bold.spiRenderInProgress = false;
                }
            })();
            window.bold.paymentRenderPromise = renderTask;
            try {
                await renderTask;
            } catch (e) {
                console.error('[Bold] renderPaymentForm failed', e);
            } finally {
                if (window.bold.paymentRenderPromise === renderTask) {
                    window.bold.paymentRenderPromise = null;
                }
            }
        },
        isBoldPaymentSelected: function () {
            const checkbox = document.getElementById('p_method_bold');
            return !!(checkbox && checkbox.checked);
        },
        ensurePaymentFormVisible: function () {
            const form = this.getPaymentFormBold();
            if (!form) {
                return;
            }
            form.style.display = '';
            if (typeof payment !== 'undefined' && payment.changeVisible) {
                payment.changeVisible('bold', false);
            }
        },
        hidePaymentFormWhenNotSelected: function () {
            const form = this.getPaymentFormBold();
            if (!form) {
                return;
            }
            if (typeof payment !== 'undefined' && payment.changeVisible) {
                payment.changeVisible('bold', true);
                return;
            }
            form.style.display = 'none';
        },
        onPaymentSectionReloaded: async function (options) {
            options = options || {};
            await this.waitForPaymentFormDom();
            this.dedupePaymentFormBoldElements();
            this.refreshDomReferences();
            if (!this.getPaymentFormBold()) {
                return;
            }
            if (!this.isAvailable) {
                this.hidePaymentMethod();
                return;
            }
            if (options.hardReload) {
                this.bumpPaymentRuntimeVersion();
                this.resetPaymentFlowState();
                await this.awaitPendingPaymentRender();
                this.clearSpiFromDom();
                if (typeof checkout !== 'undefined') {
                    checkout.setLoadWaiting(false);
                }
            }
            await this.waitForBaseInstance();
            this.scheduleRenderPaymentForm(true, !!options.hardReload);
            if (this.isBoldPaymentSelected()) {
                this.ensurePaymentFormVisible();
            } else {
                this.hidePaymentFormWhenNotSelected();
            }
            this.waitForPaymentInitialization();
            this.waitForCheckoutInitialization();
        },
        refreshPaymentFormAfterTotalsChange: async function () {
            if (!this.isCurrentRuntime() || !this.isBoldPaymentSelected()) {
                return;
            }
            if (typeof window.bold.spiTotalsRefreshInProgress !== 'undefined' && window.bold.spiTotalsRefreshInProgress) {
                return;
            }
            window.bold.spiTotalsRefreshInProgress = true;
            try {
                await this.waitForPaymentFormDom();
                this.dedupePaymentFormBoldElements();
                this.refreshDomReferences();
                if (!this.getPaymentFormBold()) {
                    return;
                }
                this.ensurePaymentFormVisible();
                this.ensurePpcpButtonsContainer();
                this.resetPaymentFlowState();
                await this.awaitPendingPaymentRender();
                if (window.bold.baseInstance && typeof window.bold.baseInstance.getCartData === 'function') {
                    try {
                        await window.bold.baseInstance.getCartData();
                    } catch (e) {
                        console.warn('[Bold] Could not refresh cart data before payment re-render', e);
                    }
                }
                await this.renderPaymentForm(true);
            } finally {
                window.bold.spiTotalsRefreshInProgress = false;
            }
        },
        onBoldPaymentMethodSelected: function () {
            if (!this.isBoldPaymentSelected()) {
                return;
            }
            this.refreshDomReferences();
            if (!this.getPaymentFormBold()) {
                return;
            }
            this.ensurePaymentFormVisible();
            if (!this.getActiveSpiFrame()) {
                this.scheduleRenderPaymentForm(true, false);
            }
        },
        hidePaymentMethod: function () {
            if (this.paymentMethodElement) {
                this.paymentMethodElement.style.display = 'none';
            }
        },
        waitForCheckoutInitialization: function () {
            const intervalId = setInterval(() => {
                if (typeof checkout !== 'undefined' && checkout.save) {
                    this.wrapCheckoutSave();
                    clearInterval(intervalId);
                }
            }, 100);
            setTimeout(() => clearInterval(intervalId), 10000);
        },
        waitForPaymentInitialization: function () {
            const intervalId = setInterval(() => {
                if (typeof payment !== 'undefined' && payment.save) {
                    this.wrapPaymentSave();
                    clearInterval(intervalId);
                }
            }, 100);
            setTimeout(() => clearInterval(intervalId), 10000);
        },
        wrapCheckoutSave: function () {
            if (this.checkoutSaveWrapped) {
                return;
            }
            this.checkoutSaveWrapped = true;
            checkout.save = checkout.save.wrap(function (original) {
                if (!this.isCurrentRuntime() || !this.paymentCheckbox || !this.paymentCheckbox.checked) {
                    return original();
                }
                checkout.validate();
                if (!this.paymentId) {
                    if (!this.canAttemptTokenize()) {
                        return;
                    }
                    checkout.setLoadWaiting('payment', true);
                    this.tokenize();
                    return;
                }
                this.isCompletingPayment = false;
                this.isTokenizing = false;
                checkout.setLoadWaiting(false);
                return original();
            }.bind(this));
        },
        wrapPaymentSave: function () {
            if (this.paymentSaveWrapped) {
                return;
            }
            this.paymentSaveWrapped = true;
            payment.save = payment.save.wrap(function (original) {
                if (!this.isCurrentRuntime() || !this.paymentCheckbox || !this.paymentCheckbox.checked) {
                    return original();
                }
                if (!this.paymentId) {
                    if (typeof checkout !== 'undefined' && checkout.save) {
                        return;
                    }
                    if (!this.canAttemptTokenize()) {
                        return;
                    }
                    checkout.setLoadWaiting('payment', true);
                    this.tokenize();
                    return;
                }
                this.isCompletingPayment = false;
                this.isTokenizing = false;
                checkout.setLoadWaiting(false);
                return original();
            }.bind(this));
        },
        tokenize: async function () {
            if (!this.isCurrentRuntime() || !this.canAttemptTokenize()) {
                return;
            }
            this.dedupeSpiFrames();
            this.isTokenizing = true;
            try {
                const iframe = this.getActiveSpiFrame();
                if (!iframe || !iframe.contentWindow) {
                    console.error('[Bold] SPI iframe is not available');
                    this.isTokenizing = false;
                    checkout.setLoadWaiting(false);
                    return;
                }
                const cartData = await window.bold.baseInstance.getCartData();
                if (!this.isCurrentRuntime()) {
                    this.isTokenizing = false;
                    return;
                }
                iframe.contentWindow.postMessage({
                    actionType: 'ACTION_SPI_TOKENIZE',
                    payload: {
                        customer: cartData.customer,
                        billing_address: cartData.billing_address,
                        shipping_address: cartData.shipping_address || cartData.billing_address,
                        totals: cartData.totals,
                    }
                }, '*');
            } catch (e) {
                this.isTokenizing = false;
                checkout.setLoadWaiting(false);
                console.error('[Bold] tokenize failed', e);
            }
        },
        isMessageFromActiveSpi: function (event) {
            const iframe = this.getActiveSpiFrame();
            return !!(iframe && iframe.contentWindow && event.source === iframe.contentWindow);
        },
        handleSpiTerminalFailure: function (reason) {
            if (!this.isCurrentRuntime()) {
                return;
            }
            if (this.lastTerminalFailureAt && (Date.now() - this.lastTerminalFailureAt) < 1000) {
                return;
            }
            this.lastTerminalFailureAt = Date.now();
            this.tokenizeCooldownUntil = Date.now() + 5000;
            this.resetPaymentFlowState();
            if (typeof checkout !== 'undefined') {
                checkout.setLoadWaiting(false);
            }
            console.warn('[Bold] Payment tokenization failed', reason || '');
        },
        subscribeToSpiEvents: function () {
            if (this.spiEventsSubscribed) {
                return;
            }
            this.spiEventsSubscribed = true;
            window.addEventListener('message', (event) => {
                const data = event.data;
                if (!data || !data.eventType) {
                    return;
                }
                const instance = window.bold.boldPaymentMethod;
                if (!instance || !instance.isCurrentRuntime() || !instance.isMessageFromActiveSpi(event)) {
                    return;
                }
                switch (data.eventType) {
                    case 'EVENT_SPI_TOKENIZED':
                        if (!data.payload || !data.payload.success) {
                            instance.handleSpiTerminalFailure('tokenize_unsuccessful');
                            return;
                        }
                        if (instance.isCompletingPayment) {
                            return;
                        }
                        instance.paymentId = data.payload?.payload?.data?.payment_id;
                        instance.isTokenizing = false;
                        instance.isCompletingPayment = true;
                        if (checkout.save) {
                            checkout.save();
                        } else {
                            payment.save();
                        }
                        break;
                    case 'EVENT_SPI_TOKENIZE_FAILED':
                        instance.handleSpiTerminalFailure('tokenize_failed');
                        break;
                    case 'EVENT_SPI_PAYMENT_ORDER_SCA':
                        instance.isTokenizing = false;
                        checkout.setLoadWaiting(false);
                        break;
                    case 'EVENT_SPI_ENABLE_FULLSCREEN':
                        checkout.setLoadWaiting(false);
                        break;
                    case 'EVENT_SPI_DISABLE_FULLSCREEN':
                        if (instance.tokenizeCooldownUntil && Date.now() < instance.tokenizeCooldownUntil) {
                            checkout.setLoadWaiting(false);
                            break;
                        }
                        if (instance.isTokenizing || instance.isCompletingPayment) {
                            checkout.setLoadWaiting('payment', true);
                        }
                        break;
                    default:
                        if (data.eventType && data.eventType.indexOf('FAIL') !== -1) {
                            instance.handleSpiTerminalFailure(data.eventType);
                        }
                        break;
                }
            });
        },
    });

    if (typeof window.bold === 'undefined') {
        window.bold = {};
    }

    window.bold.initBoldPaymentMethod = function () {
        if (!<?php echo $this->isAvailable(); ?>) {
            return;
        }
        if (!window.bold.boldPaymentMethod) {
            window.bold.boldPaymentMethod = new BoldPaymentMethod();
        }
    };

    window.bold.onBoldPaymentFormInjected = function () {
        if (!<?php echo $this->isAvailable(); ?>) {
            return;
        }
        if (window.bold.firecheckoutPaymentReloadTimer) {
            return;
        }
        if (!window.bold.baseInstance) {
            window.bold.baseInstance = new BoldBase();
        }
        if (!window.bold.boldPaymentMethod) {
            window.bold.initBoldPaymentMethod();
            return;
        }
        window.bold.boldPaymentMethod.onPaymentSectionReloaded({hardReload: false});
    };

    window.bold.handleFirecheckoutPaymentSectionReload = async function () {
        if (!<?php echo $this->isAvailable(); ?>) {
            return;
        }
        if (!window.bold.baseInstance) {
            window.bold.baseInstance = new BoldBase();
        }
        if (!window.bold.boldPaymentMethod) {
            window.bold.initBoldPaymentMethod();
            return;
        }
        await window.bold.boldPaymentMethod.onPaymentSectionReloaded({hardReload: true});
        if (typeof payment !== 'undefined' && payment.currentMethod === 'bold') {
            window.bold.handleBoldPaymentMethodSelected();
        }
    };

    window.bold.handleBoldPaymentMethodSelected = function () {
        if (!<?php echo $this->isAvailable(); ?>) {
            return;
        }
        if (!window.bold.boldPaymentMethod) {
            window.bold.initBoldPaymentMethod();
            return;
        }
        window.bold.boldPaymentMethod.onBoldPaymentMethodSelected();
    };

    window.bold.handleBoldPaymentTotalsChange = function () {
        if (!<?php echo $this->isAvailable(); ?>) {
            return;
        }
        if (typeof payment === 'undefined' || payment.currentMethod !== 'bold') {
            return;
        }
        if (!window.bold.baseInstance) {
            window.bold.baseInstance = new BoldBase();
        }
        if (!window.bold.boldPaymentMethod) {
            window.bold.initBoldPaymentMethod();
            return;
        }
        if (window.bold.firecheckoutTotalsChangeTimer) {
            clearTimeout(window.bold.firecheckoutTotalsChangeTimer);
        }
        window.bold.firecheckoutTotalsChangeTimer = setTimeout(function () {
            window.bold.firecheckoutTotalsChangeTimer = null;
            window.bold.boldPaymentMethod.refreshPaymentFormAfterTotalsChange();
        }, 500);
    };

    if (!window.bold.firecheckoutPaymentReloadRegistered) {
        window.bold.firecheckoutPaymentReloadRegistered = true;
        document.observe('firecheckout:setResponseAfter', function (e) {
            const sections = e.memo.response && e.memo.response.update_section;
            if (!sections) {
                return;
            }
            if (sections['payment-method']) {
                if (window.bold.firecheckoutPaymentReloadTimer) {
                    clearTimeout(window.bold.firecheckoutPaymentReloadTimer);
                }
                window.bold.firecheckoutPaymentReloadTimer = setTimeout(function () {
                    window.bold.firecheckoutPaymentReloadTimer = null;
                    window.bold.handleFirecheckoutPaymentSectionReload();
                }, 500);
                return;
            }
            if (sections['shipping-method'] || sections['cart'] || sections['total']) {
                window.bold.handleBoldPaymentTotalsChange();
            }
        });
        document.observe('payment-method:switched', function (e) {
            if (e.memo && e.memo.method_code === 'bold') {
                window.bold.handleBoldPaymentMethodSelected();
            }
        });
        document.observe('payment-method:switched-off', function (e) {
            if (e.memo && e.memo.method_code === 'bold' && window.bold.boldPaymentMethod) {
                window.bold.boldPaymentMethod.hidePaymentFormWhenNotSelected();
            }
        });
        document.observe('firecheckout:paymentMethod:afterInitAfter', function () {
            if (typeof payment !== 'undefined' && payment.currentMethod === 'bold') {
                window.bold.handleBoldPaymentMethodSelected();
            }
        });
    }

    function boldBoosterBootstrap() {
        if (!window.bold.baseInstance) {
            window.bold.baseInstance = new BoldBase();
        }
        window.bold.initBoldPaymentMethod();
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        boldBoosterBootstrap();
    } else {
        document.observe('dom:loaded', boldBoosterBootstrap);
    }
</script>
